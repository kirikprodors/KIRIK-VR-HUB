-- // 4. МОДЕЛИ РУК И ОРУЖИЯ
local function buildArm(isLeft)
    local m = Instance.new("Model")
    m.Name = isLeft and "VR_L" or "VR_R"
    local st = STYLES[HAND_STYLE]
    local c, cuffC, mat = st.Col, st.Cuff, st.Mat
    
    if HAND_STYLE == 1 then
        local char = player.Character
        local rp = char and (char:FindFirstChild(isLeft and "LeftHand" or "RightHand") or char:FindFirstChild(isLeft and "Left Arm" or "Right Arm") or char:FindFirstChild("Head"))
        c = rp and rp.Color or Color3.fromRGB(225, 185, 145)
    end

    local function mk(name, sz, offZ)
        local p = Instance.new("Part")
        p.Name, p.Size, p.Color, p.Material = name, sz, (name == "Cuff" and cuffC or c), (name == "Cuff" and Enum.Material.Neon or mat)
        p.TopSurface, p.BottomSurface, p.LeftSurface, p.RightSurface, p.FrontSurface, p.BackSurface = 0,0,0,0,0,0
        p.CanCollide, p.CanTouch, p.CanQuery, p.Anchored, p.CastShadow, p.Parent = false, false, false, true, false, m
        return p
    end
    mk("Forearm", Vector3.new(0.48, 0.48, 1.1))
    mk("Cuff", Vector3.new(0.52, 0.52, 0.1))
    mk("Palm", Vector3.new(0.44, 0.35, 0.5))
    mk("Fingers", Vector3.new(0.42, 0.28, 0.3))
    m.Parent = viewmodelFolder
    return m
end

local function setupHands()
    if viewmodelFolder then viewmodelFolder:Destroy() end
    viewmodelFolder = Instance.new("Folder")
    viewmodelFolder.Name = "VR_Rig"
    viewmodelFolder.Parent = camera
    leftArmModel, rightArmModel = buildArm(true), buildArm(false)
end

-- // 5. ИНТЕРАКТИВ (КАМЕРА И ТАПЫ)
UserInputService.InputBegan:Connect(function(input, processed)
    if not VR_ACTIVE then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local posX = input.Position.X
        if posX > camera.ViewportSize.X * 0.42 and not processed and not EDITING_UI then cameraTouchInput = input end
        
        if not processed and not EDITING_UI then
            local ray = camera:ViewportPointToRay(input.Position.X, input.Position.Y)
            local localDir = camera.CFrame:VectorToObjectSpace(ray.Direction).Unit
            local aimRot = CFrame.lookAt(Vector3.zero, localDir)
            if posX < camera.ViewportSize.X * 0.5 then tapReachL, tapRotL, tapAlphaL = localDir * 1.4, aimRot, 1
            else tapReachR, tapRotR, tapAlphaR = localDir * 1.4, aimRot, 1 end
        end
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if VR_ACTIVE and input == cameraTouchInput then
        local delta = input.Delta
        if delta.Magnitude > 0 then
            touchYaw = touchYaw - delta.X * (0.004 * SENS_MULTIPLIER)
            touchPitch = math.clamp(touchPitch - delta.Y * (0.004 * SENS_MULTIPLIER), math.rad(-75), math.rad(75))
        end
    end
end)
UserInputService.InputEnded:Connect(function(input) if input == cameraTouchInput then cameraTouchInput = nil end end)
if UserInputService.GyroscopeEnabled then gyroConnection = UserInputService.DeviceRotationChanged:Connect(function(_, rotCFrame) rawGyroCF = rotCFrame end) end

-- // 6. ГЛАВНЫЙ ЦИКЛ VR
local function startVR()
    VR_ACTIVE = true
    camera.CameraType = Enum.CameraType.Scriptable
    dpadContainer.Visible, handContL.Visible, handContR.Visible = true, true, true
    baseGyroCF, smoothedCamRot, lastCamCF = rawGyroCF, CFrame.identity, camera.CFrame
    touchYaw, touchPitch = 0, 0
    camera.FieldOfView = FOV_MODES[FOV_INDEX]
    setupHands()

    toggleBtn.Text, toggleBtn.TextColor3 = "⏻ ВЫКЛЮЧИТЬ VR", Color3.fromRGB(255, 80, 80)
    cardStroke.Color = Color3.fromRGB(255, 80, 80)

    physicsLoopConnection = RunService.Stepped:Connect(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if char and root and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid").AutoRotate = false
            local look = camera.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude > 0.05 then
                root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, root.Position + flatLook.Unit), 0.35)
            end
        end
    end)

    mainLoopConnection = RunService.RenderStepped:Connect(function(dt)
        local char = player.Character
        if not char then return end

        for _, item in ipairs(char:GetDescendants()) do
            if item:IsA("BasePart") and not item:IsDescendantOf(char:FindFirstChildOfClass("Tool") or game) then
                item.LocalTransparencyModifier = 1
            end
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")
        if not head or not root or not humanoid then return end

        if not EDITING_UI then
            local moveZ = (moveForward and -1 or 0) + (moveBackward and 1 or 0)
            local moveX = (moveRight and 1 or 0) + (moveLeft and -1 or 0)
            if moveZ ~= 0 or moveX ~= 0 then
                local _, camYaw, _ = camera.CFrame:ToEulerAnglesYXZ()
                local moveDir = CFrame.Angles(0, camYaw, 0) * Vector3.new(moveX, 0, moveZ)
                if moveDir.Magnitude > 0.01 then humanoid:Move(moveDir.Unit, false) end
            else humanoid:Move(Vector3.zero, false) end
        end

        local targetRot
        if CONTROL_MODE == "GYRO" then
            local rx, ry, rz = baseGyroCF:ToObjectSpace(rawGyroCF):ToEulerAnglesYXZ()
            targetRot = CFrame.Angles(0, -rz + touchYaw, 0) * CFrame.Angles(math.clamp(-rx, math.rad(-75), math.rad(75)) + touchPitch, 0, 0)
        else targetRot = CFrame.Angles(0, touchYaw, 0) * CFrame.Angles(touchPitch, 0, 0) end
        
        smoothedCamRot = smoothedCamRot:Lerp(targetRot, 0.4)
        camera.CFrame = CFrame.new(head.Position + Vector3.new(0, IS_CROUCHING and -1.4 or 0.25, 0)) * smoothedCamRot
        local camCF = camera.CFrame

        local dRot = camCF:ToObjectSpace(lastCamCF)
        swayCF = swayCF:Lerp(CFrame.Angles(math.clamp(dRot.X*0.5, -0.12, 0.12), math.clamp(dRot.Y*0.5, -0.12, 0.12), 0), 0.25)
        lastCamCF = camCF

        bobStep = bobStep + dt * (root.AssemblyLinearVelocity.Magnitude > 1 and 8 or 2.5)
        local bobX, bobY = math.sin(bobStep)*0.02, math.cos(bobStep*2)*0.015

        tapAlphaL, tapAlphaR = math.clamp(tapAlphaL - dt*4, 0, 1), math.clamp(tapAlphaR - dt*4, 0, 1)
        currentHandOffsetL = currentHandOffsetL:Lerp(handDragL + (tapReachL * tapAlphaL), 0.28)
        currentHandOffsetR = currentHandOffsetR:Lerp(handDragR + (tapReachR * tapAlphaR), 0.28)

        local function updateArm(arm, isL, off, tRot, tAlpha, wPitch, wYaw)
            if not arm then return end
            local side = isL and -1 or 1
            local userWrist = CFrame.Angles(wPitch, wYaw, 0)
            local baseAngle = CFrame.Angles(math.rad(12 - off.Z*20 + off.Y*16), math.rad(-side*8 + off.X*20), math.rad(side*4)) * userWrist
            local finalAngle = baseAngle:Lerp(tRot, tAlpha*0.8)

            local base = camCF * swayCF * CFrame.new(side*(0.65 - (side*bobX)) + off.X, -0.65 + bobY + off.Y, -1.05 + off.Z) * finalAngle
            local f, c, p, fg = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("Palm"), arm:FindFirstChild("Fingers")
            if f and c and p and fg then
                f.CFrame, c.CFrame = base * CFrame.new(0, 0, 0.35), base * CFrame.new(0, 0, -0.22)
                p.CFrame, fg.CFrame = base * CFrame.new(0, -0.02, -0.5) * CFrame.Angles(math.rad(8), 0, 0), base * CFrame.new(0, -0.05, -0.85) * CFrame.Angles(math.rad(18), 0, 0)
            end
        end

        updateArm(leftArmModel, true, currentHandOffsetL, tapRotL, tapAlphaL, wristPitchL, wristYawL)
        updateArm(rightArmModel, false, currentHandOffsetR, tapRotR, tapAlphaR, wristPitchR, wristYawR)

        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local rightGrip = nil
            for _, v in ipairs(char:GetDescendants()) do if v:IsA("Weld") and v.Name == "RightGrip" then rightGrip = v break end end
            local vrPalm = rightArmModel and rightArmModel:FindFirstChild("Palm")
            if rightGrip and vrPalm then
                rightGrip.Part0, rightGrip.C0, rightGrip.C1 = vrPalm, CFrame.new(0, -0.1, -0.3) * CFrame.Angles(math.rad(-90), 0, 0), tool.Grip
            end
        end
    end)
end

local function stopVR()
    VR_ACTIVE = false
    dpadContainer.Visible, handContL.Visible, handContR.Visible = false, false, false
    moveForward, moveBackward, moveLeft, moveRight = false, false, false, false
    if mainLoopConnection then mainLoopConnection:Disconnect() mainLoopConnection = nil end
    if physicsLoopConnection then physicsLoopConnection:Disconnect() physicsLoopConnection = nil end
    camera.CameraType, camera.FieldOfView = Enum.CameraType.Custom, 70
    local char = player.Character
    if char then
        if char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid").AutoRotate = true end
        for _, item in ipairs(char:GetDescendants()) do if item:IsA("BasePart") then item.LocalTransparencyModifier = 0 end end
    end
    if viewmodelFolder then viewmodelFolder:Destroy() viewmodelFolder = nil end
    toggleBtn.Text, toggleBtn.TextColor3, cardStroke.Color = "⏻ ВКЛЮЧИТЬ VR", Color3.fromRGB(0, 255, 180), Color3.fromRGB(0, 255, 180)
end

