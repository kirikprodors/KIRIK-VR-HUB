local function findClimbWallTarget(palmPart)
    if not palmPart then return nil, nil end
    local pPos = palmPart.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {player.Character, viewmodelFolder}
    local dirs = {
        camera.CFrame.LookVector * 4.5,
        palmPart.CFrame.LookVector * 4.0,
        (camera.CFrame.LookVector + palmPart.CFrame.LookVector).Unit * 4.0
    }
    for _, dir in ipairs(dirs) do
        local res = workspace:Raycast(pPos, dir, rayParams)
        if res and res.Instance and res.Instance:IsA("BasePart") and res.Instance.CanCollide and res.Instance.Anchored then
            local norm = safeUnit(res.Normal, Vector3.new(0, 0, 1))
            return res.Position, norm
        end
    end
    return nil, nil
end
local function findUniversalGrabTarget(palmPart, maxDist)
    if not palmPart then return nil end
    local pPos = palmPart.Position
    local closestObj = nil
    local closestDist = maxDist or 8.5
    for _, otherPlr in ipairs(Players:GetPlayers()) do
        if otherPlr ~= player and otherPlr.Character then
            local rPart = otherPlr.Character:FindFirstChild("HumanoidRootPart") or otherPlr.Character:FindFirstChild("Head") or otherPlr.Character:FindFirstChild("Torso")
            if rPart then
                local d = (rPart.Position - pPos).Magnitude
                if d < closestDist then
                    closestDist = d
                    closestObj = {Type = "PLAYER", Target = otherPlr, Part = rPart, Name = otherPlr.Name, UserId = otherPlr.UserId}
                end
            end
        end
    end
    if not closestObj then
        local overlapParams = OverlapParams.new()
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude
        overlapParams.FilterDescendantsInstances = {player.Character, viewmodelFolder}
        local nearbyParts = workspace:GetPartBoundsInRadius(pPos, closestDist, overlapParams)
        for _, p in ipairs(nearbyParts) do
            if p:IsA("BasePart") and p.Transparency < 0.95 and p.Size.Magnitude < 35 and not p.Anchored then
                if p:IsA("Seat") or p:IsA("VehicleSeat") then continue end
                local targetChar = p:FindFirstAncestorOfClass("Model")
                local targetPlr = targetChar and Players:GetPlayerFromCharacter(targetChar)
                if targetPlr and targetPlr ~= player then
                    local rPart = targetChar:FindFirstChild("HumanoidRootPart") or p
                    closestObj = {Type = "PLAYER", Target = targetPlr, Part = rPart, Name = targetPlr.Name, UserId = targetPlr.UserId}
                    break
                elseif not targetPlr then
                    if targetChar and (targetChar:FindFirstChildOfClass("VehicleSeat") or targetChar:FindFirstChildOfClass("Seat")) then
                        continue
                    end
                    if p.AssemblyMass > 350 then continue end
                    local d = (p.Position - pPos).Magnitude
                    if d < closestDist then
                        closestDist = d
                        if targetChar and targetChar.PrimaryPart and targetChar ~= workspace then
                            closestObj = {Type = "MODEL", Target = targetChar, Part = targetChar.PrimaryPart, Name = targetChar.Name}
                        else
                            closestObj = {Type = "PART", Target = p, Part = p, Name = p.Name}
                        end
                    end
                end
            end
        end
    end
    return closestObj
end
