                curRoot.AssemblyAngularVelocity = Vector3.zero
            end
            if not isSeated then
                humanoid.AutoRotate = false
            else
                humanoid.AutoRotate = true
            end
            if isClimbingL or isClimbingR or beingGrabbedBy then
                humanoid.PlatformStand = true
                curRoot.AssemblyLinearVelocity = Vector3.zero
                curRoot.AssemblyAngularVelocity = Vector3.zero
            else
                if not isSeated then
                    humanoid.PlatformStand = false
                end
            end
        end)
    end)
    mainLoopConnection = RunService.RenderStepped:Connect(function(rawDt)
        pcall(function()
            local dt = math.clamp(rawDt, 0.001, 0.05)
            local curChar = player.Character
            if not curChar then return end
            local curRoot = curChar:FindFirstChild("HumanoidRootPart")
            local humanoid = curChar and curChar:FindFirstChildOfClass("Humanoid")
            local head = curChar:FindFirstChild("Head")
            if not head or not curRoot or not humanoid then return end
            local isSeated = humanoid.Sit
            local currentTool = curChar:FindFirstChildOfClass("Tool")
            for _, item in ipairs(curChar:GetDescendants()) do
                if item:IsA("BasePart") or item:IsA("Decal") then
                    if currentTool and item:IsDescendantOf(currentTool) then
                        item.LocalTransparencyModifier = 0
                        if item:IsA("BasePart") then
                            item.CanCollide = false
                            item.Massless = true
                        end
                    else
                        item.LocalTransparencyModifier = 1
                    end
                end
            end
            if not EDITING_UI and not beingGrabbedBy and not isSeated then
                if isClimbingL or isClimbingR then
                    if not climbHoldPosition or isNaN(climbHoldPosition.X) then
                        climbHoldPosition = curRoot.Position
                    end
                    curRoot.AssemblyLinearVelocity = Vector3.zero
                    curRoot.AssemblyAngularVelocity = Vector3.zero
                    local climbMove = Vector3.zero
                    local rightPlane = safeUnit(camera.CFrame.RightVector * Vector3.new(1, 0, 1), Vector3.new(1, 0, 0))
                    if moveForward then climbMove = climbMove + Vector3.new(0, 1, 0) end
                    if moveBackward then climbMove = climbMove - Vector3.new(0, 1, 0) end
                    if moveRight then climbMove = climbMove + rightPlane end
                    if moveLeft then climbMove = climbMove - rightPlane end
                    if isClimbingL then climbMove = climbMove + Vector3.new(0, -handDragL.Y * 1.8, 0) + (rightPlane * -handDragL.X * 1.8) end
                    if isClimbingR then climbMove = climbMove + Vector3.new(0, -handDragR.Y * 1.8, 0) + (rightPlane * -handDragR.X * 1.8) end
                    local proposedPos = climbHoldPosition
                    if climbMove.Magnitude > 0.05 then
                        proposedPos = climbHoldPosition + (climbMove.Unit * (18 * dt))
                    end
                    if isClimbingL and not isClimbingR and climbAnchorPosL then
                        local diff = proposedPos - climbAnchorPosL
                        if diff.Magnitude > MAX_CLIMB_REACH then
                            proposedPos = climbAnchorPosL + (safeUnit(diff, Vector3.new(0, 1, 0)) * MAX_CLIMB_REACH)
                        end
                    elseif isClimbingR and not isClimbingL and climbAnchorPosR then
                        local diff = proposedPos - climbAnchorPosR
                        if diff.Magnitude > MAX_CLIMB_REACH then
                            proposedPos = climbAnchorPosR + (safeUnit(diff, Vector3.new(0, 1, 0)) * MAX_CLIMB_REACH)
                        end
                    elseif isClimbingL and isClimbingR and climbAnchorPosL and climbAnchorPosR then
                        local midAnchor = (climbAnchorPosL + climbAnchorPosR) * 0.5
                        local diff = proposedPos - midAnchor
                        if diff.Magnitude > MAX_CLIMB_REACH + 0.5 then
                            proposedPos = midAnchor + (safeUnit(diff, Vector3.new(0, 1, 0)) * (MAX_CLIMB_REACH + 0.5))
                        end
                    end
                    climbHoldPosition = safeVec3(proposedPos, curRoot.Position)
                    local normL = isClimbingL and wallNormalL or Vector3.zero
                    local normR = isClimbingR and wallNormalR or Vector3.zero
                    local avgNorm = safeUnit(normL + normR, Vector3.new(0, 0, 1))
                    local wallRayParams = RaycastParams.new()
                    wallRayParams.FilterType = Enum.RaycastFilterType.Exclude
                    wallRayParams.FilterDescendantsInstances = {curChar, viewmodelFolder}
                    local wallCheck = workspace:Raycast(climbHoldPosition, -avgNorm * 4.0, wallRayParams)
                    if wallCheck then
                        local minWallDist = 1.85
                        local curDist = (wallCheck.Position - climbHoldPosition).Magnitude
                        if curDist < minWallDist then
                            climbHoldPosition = wallCheck.Position + (wallCheck.Normal * minWallDist)
                        end
                    end
                    local horizontalNorm = safeUnit(Vector3.new(avgNorm.X, 0, avgNorm.Z), Vector3.new(0, 0, 1))
                    curRoot.CFrame = safeLookAt(climbHoldPosition, climbHoldPosition - horizontalNorm)
                else
                    climbHoldPosition = nil
                    local moveZ = (moveForward and -1 or 0) + (moveBackward and 1 or 0)
                    local moveX = (moveRight and 1 or 0) + (moveLeft and -1 or 0)
                    if moveZ ~= 0 or moveX ~= 0 then
                        local _, camYaw, _ = camera.CFrame:ToEulerAnglesYXZ()
                        local moveDir = CFrame.Angles(0, camYaw, 0) * Vector3.new(moveX, 0, moveZ)
                        humanoid:Move(safeUnit(moveDir, Vector3.zero), false)
                    else
                        humanoid:Move(Vector3.zero, false)
                    end
                    local look = camera.CFrame.LookVector
                    local flatLook = safeUnit(Vector3.new(look.X, 0, look.Z), Vector3.new(0, 0, -1))
                    curRoot.CFrame = safeLookAt(curRoot.Position, curRoot.Position + flatLook)
                end
            end
            if beingGrabbedBy and remoteVRUsers[beingGrabbedBy.Grabber] and not isSeated then
                local grabberData = remoteVRUsers[beingGrabbedBy.Grabber]
                local grabCF = (beingGrabbedBy.Hand == "L") and grabberData.CurrentL or grabberData.CurrentR
                local d = beingGrabbedBy.Dist or 4.0
                if grabCF and curRoot then
                    local targetHoldCF = grabCF * CFrame.new(0, 0, -d)
                    curRoot.CFrame = curRoot.CFrame:Lerp(targetHoldCF, 0.45)
                    curRoot.AssemblyLinearVelocity = Vector3.zero
                    curRoot.AssemblyAngularVelocity = Vector3.zero
                end
            end
            local targetRot
            if CONTROL_MODE == "GYRO" then
                local rx, ry, rz = baseGyroCF:ToObjectSpace(rawGyroCF):ToEulerAnglesYXZ()
                targetRot = CFrame.Angles(0, -rz + touchYaw, 0) * CFrame.Angles(math.clamp(-rx, math.rad(-75), math.rad(75)) + touchPitch, 0, 0)
            else
                targetRot = CFrame.Angles(0, touchYaw, 0) * CFrame.Angles(touchPitch, 0, 0)
            end
            smoothedCamRot = smoothedCamRot:Lerp(targetRot, 0.4)
            local isMoving = curRoot.AssemblyLinearVelocity.Magnitude > 1.5
            bobStep = bobStep + dt * (isMoving and 8.5 or 2.2)
            local bobX, bobY = math.sin(bobStep) * 0.018, math.cos(bobStep * 2) * 0.012
            local camWalkLift = (isMoving and not (isClimbingL or isClimbingR or isSeated)) and (math.abs(math.sin(bobStep)) * 0.12) or 0
            local camTiltRoll = (isMoving and not (isClimbingL or isClimbingR or isSeated)) and (math.sin(bobStep) * 0.014) or 0
            local headBaseHeight = IS_CROUCHING and -1.4 or 0.25
            camera.CFrame = CFrame.new(head.Position + Vector3.new(0, headBaseHeight + camWalkLift, 0)) 
                * smoothedCamRot 
                * CFrame.Angles(0, 0, camTiltRoll)
            local camCF = camera.CFrame
            local dRot = camCF:ToObjectSpace(lastCamCF)
            swayCF = swayCF:Lerp(CFrame.Angles(math.clamp(dRot.X * 0.4, -0.08, 0.08), math.clamp(dRot.Y * 0.4, -0.08, 0.08), 0), 0.25)
            lastCamCF = camCF
            tapAlphaL = math.clamp(tapAlphaL - dt * 4, 0, 1)
            tapAlphaR = math.clamp(tapAlphaR - dt * 4, 0, 1)
            currentHandOffsetL = currentHandOffsetL:Lerp(handDragL + (tapReachL * tapAlphaL), 0.28)
            currentHandOffsetR = currentHandOffsetR:Lerp(handDragR + (tapReachR * tapAlphaR), 0.28)
            local targetCurlsL = (grabbedDataL ~= nil or isClimbingL) and GESTURES[2].Curls or GESTURES[gestureIndexL].Curls
            local targetCurlsR = (grabbedDataR ~= nil or isClimbingR) and GESTURES[2].Curls or GESTURES[gestureIndexR].Curls
            local emoteOffsetL, emoteOffsetR = Vector3.zero, Vector3.zero
            local emoteRotL, emoteRotR = CFrame.identity, CFrame.identity
            if activeEmoteId then
                emoteElapsed = emoteElapsed + dt
                local currEmoteDef = nil
                for _, em in ipairs(EMOTES) do if em.Id == activeEmoteId then currEmoteDef = em break end end
                if currEmoteDef and emoteElapsed > currEmoteDef.Duration then
                    activeEmoteId = nil
                    emoteElapsed = 0
                    emotePlayBtn.Text = "▶️ СТАРТ ЭМОЦИИ"
                    emotePlayBtn.TextColor3 = Color3.fromRGB(0, 255, 180)
                else
                    local eOffL, eOffR, eRotL, eRotR, efL, efR = evaluateEmotePose(activeEmoteId, emoteElapsed, camCF)
                    emoteOffsetL, emoteOffsetR = eOffL, eOffR
                    emoteRotL, emoteRotR = eRotL, eRotR
                    targetCurlsL, targetCurlsR = efL, efR
                end
            end
            for i = 1, 5 do
                currentCurlsL[i] = currentCurlsL[i] + (targetCurlsL[i] - currentCurlsL[i]) * (1 - math.exp(-22 * dt))
                currentCurlsR[i] = currentCurlsR[i] + (targetCurlsR[i] - currentCurlsR[i]) * (1 - math.exp(-22 * dt))
            end
            local finalLeftCF, finalRightCF = nil, nil
            local function updateArm(arm, isL, off, tRot, tAlpha, wPitch, wYaw, wRoll, isClimbing, wallAnchor, curls, eOff, eRot)
                if not arm then return end
                local side = isL and -1 or 1
                local userWrist = CFrame.Angles(wPitch, wYaw, wRoll or 0)
                local baseAngle = CFrame.Angles(math.rad(-14 + off.Y * 18 - off.Z * 12), math.rad(-side * 8 + off.X * 16), math.rad(side * 6)) * userWrist
                local finalAngle = baseAngle:Lerp(tRot, tAlpha * 0.8) * (eRot or CFrame.identity)
                local base = camCF * swayCF * CFrame.new(side * (0.68 - (side * bobX)) + off.X + eOff.X, -0.85 + bobY + off.Y + eOff.Y, -1.15 + off.Z + eOff.Z) * finalAngle
                if isClimbing and wallAnchor then
                    base = CFrame.new(wallAnchor) * (base - base.Position)
                end
                if isL then finalLeftCF = base else finalRightCF = base end
                local f, c, cr, p, ap = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("CuffRing"), arm:FindFirstChild("Palm"), arm:FindFirstChild("ArmorPlate")
                if f and c and p then
                    f.CFrame = base * CFrame.new(0, -0.02, 0.40)
                    c.CFrame = base * CFrame.new(0, -0.01, -0.08)
                    if cr then cr.CFrame = base * CFrame.new(0, -0.01, -0.16) end
                    p.CFrame = base * CFrame.new(0, 0, -0.32)
                    if ap then ap.CFrame = base * CFrame.new(0, 0.12, -0.32) end
                    applyFingerKinematics(arm, isL, base, curls)
                end
            end
            updateArm(leftArmModel, true, currentHandOffsetL, tapRotL, tapAlphaL, wristPitchL, wristYawL, wristRollL, isClimbingL, climbAnchorPosL, currentCurlsL, emoteOffsetL, emoteRotL)
            updateArm(rightArmModel, false, currentHandOffsetR, tapRotR, tapAlphaR, wristPitchR, wristYawR, wristRollR, isClimbingR, climbAnchorPosR, currentCurlsR, emoteOffsetR, emoteRotR)
            if currentTool then
                local rightGrip = nil
                for _, v in ipairs(curChar:GetDescendants()) do 
                    if v:IsA("Weld") and (v.Name == "RightGrip" or v.Name == "ToolGrip") then 
                        rightGrip = v 
                        break 
                    end 
                end
                local vrPalmR = rightArmModel and rightArmModel:FindFirstChild("Palm")
                local vrPalmL = leftArmModel and leftArmModel:FindFirstChild("Palm")
                if rightGrip and vrPalmR then
                    rightGrip.Part0 = vrPalmR
                    if TWO_HAND_MODE and vrPalmL then
                        local diff = (vrPalmR.Position - vrPalmL.Position)
                        if diff.Magnitude > 0.25 then
                            local lookRotation = safeLookAt(vrPalmR.Position, vrPalmR.Position + diff.Unit)
                            rightGrip.C0 = vrPalmR.CFrame:ToObjectSpace(lookRotation) * CFrame.Angles(math.rad(-90), 0, math.rad(90))
                        else
                            rightGrip.C0 = CFrame.new(0, -0.05, -0.15) * CFrame.Angles(math.rad(-90), 0, 0)
                        end
                    else
                        rightGrip.C0 = CFrame.new(0, -0.05, -0.15) * CFrame.Angles(math.rad(-90), 0, 0)
                    end
                    rightGrip.C1 = currentTool.Grip
                end
            end
            if OBJECT_GRAB_ENABLED then
                local vrPalmL = leftArmModel and leftArmModel:FindFirstChild("Palm")
                local vrPalmR = rightArmModel and rightArmModel:FindFirstChild("Palm")
                if grabbedDataL and grabbedDataR and grabbedDataL.Target == grabbedDataR.Target and vrPalmL and vrPalmR then
                    local targetObj = grabbedDataL
                    local pL, pR = vrPalmL.Position, vrPalmR.Position
                    local midPos = (pL + pR) * 0.5
                    local forwardDir = camera.CFrame.LookVector
                    local holdPos = midPos + (forwardDir * grabDistBoth)
                    local handRoll = math.atan2(pR.Y - pL.Y, math.max(0.1, (Vector2.new(pR.X, pR.Z) - Vector2.new(pL.X, pL.Z)).Magnitude))
                    local holdRot = safeLookAt(holdPos, holdPos + forwardDir) * CFrame.Angles(wristPitchR, wristYawR, handRoll)
                    if targetObj.Type == "PLAYER" then
                        targetObj.Part.CFrame = targetObj.Part.CFrame:Lerp(holdRot, 0.35)
                    elseif targetObj.Type == "MODEL" then
                        targetObj.Target:PivotTo(targetObj.Target:GetPivot():Lerp(holdRot, 0.35))
                    else
                        targetObj.Part.CanCollide = false
                        targetObj.Part.CFrame = targetObj.Part.CFrame:Lerp(holdRot, 0.35)
                    end
                    targetObj.Part.AssemblyLinearVelocity = Vector3.zero
                else
                    if grabbedDataL and vrPalmL and grabbedDataL.Part then
                        local holdCF = vrPalmL.CFrame * CFrame.new(0, 0, -grabDistL) * CFrame.Angles(wristPitchL, wristYawL, 0)
                        if grabbedDataL.Type == "PLAYER" then
                            grabbedDataL.Part.CFrame = grabbedDataL.Part.CFrame:Lerp(holdCF, 0.35)
                        elseif grabbedDataL.Type == "MODEL" then
                            grabbedDataL.Target:PivotTo(grabbedDataL.Target:GetPivot():Lerp(holdCF, 0.35))
                        else
                            grabbedDataL.Part.CanCollide = false
                            grabbedDataL.Part.CFrame = grabbedDataL.Part.CFrame:Lerp(holdCF, 0.35)
                        end
                        grabbedDataL.Part.AssemblyLinearVelocity = Vector3.zero
                    end
                    if grabbedDataR and vrPalmR and grabbedDataR.Part then
                        local holdCF = vrPalmR.CFrame * CFrame.new(0, 0, -grabDistR) * CFrame.Angles(wristPitchR, wristYawR, 0)
                        if grabbedDataR.Type == "PLAYER" then
                            grabbedDataR.Part.CFrame = grabbedDataR.Part.CFrame:Lerp(holdCF, 0.35)
                        elseif grabbedDataR.Type == "MODEL" then
                            grabbedDataR.Target:PivotTo(grabbedDataR.Target:GetPivot():Lerp(holdCF, 0.35))
                        else
                            grabbedDataR.Part.CanCollide = false
                            grabbedDataR.Part.CFrame = grabbedDataR.Part.CFrame:Lerp(holdCF, 0.35)
                        end
                        grabbedDataR.Part.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
            if NETWORK_ENABLED and wsConnection and tick() - lastNetSend > 0.07 and finalLeftCF and finalRightCF then
                local pL, pR = finalLeftCF.Position, finalRightCF.Position
                local posChanged = (pL - lastSentPosL).Magnitude > 0.04 or (pR - lastSentPosR).Magnitude > 0.04 or isClimbingL or isClimbingR or grabbedDataL ~= nil or grabbedDataR ~= nil
                if posChanged or tick() - lastNetSend > 0.4 then
                    lastNetSend = tick()
                    lastSentPosL, lastSentPosR = pL, pR
                    pcall(function()
                        local shoulderL = curRoot.CFrame * CFrame.new(-1.1, -0.15, -0.2)
                        local shoulderR = curRoot.CFrame * CFrame.new(1.1, -0.15, -0.2)
                        local relL = shoulderL:ToObjectSpace(finalLeftCF)
                        local relR = shoulderR:ToObjectSpace(finalRightCF)
                        local lpPos, lpRot = cfToArr(relL)
                        local rpPos, rpRot = cfToArr(relR)
                        local wlpPos, wlpRot = cfToArr(finalLeftCF)
                        local wrpPos, wrpRot = cfToArr(finalRightCF)
                        local hpPos, hpRot = cfToArr(camCF)
                        local grabPacket = nil
                        if grabbedDataL and grabbedDataL.Type == "PLAYER" and grabbedDataR and grabbedDataR.Type == "PLAYER" and grabbedDataL.Target == grabbedDataR.Target then
                            grabPacket = {target = grabbedDataL.Target.UserId, hand = "BOTH", dist = r2(grabDistBoth)}
                        elseif grabbedDataL and grabbedDataL.Type == "PLAYER" then
                            grabPacket = {target = grabbedDataL.Target.UserId, hand = "L", dist = r2(grabDistL)}
                        elseif grabbedDataR and grabbedDataR.Type == "PLAYER" then
                            grabPacket = {target = grabbedDataR.Target.UserId, hand = "R", dist = r2(grabDistR)}
                        end
                        local objLData = grabbedDataL and {Name = grabbedDataL.Name, Type = grabbedDataL.Type, UserId = grabbedDataL.UserId, Dist = r2(grabDistL)} or nil
                        local objRData = grabbedDataR and {Name = grabbedDataR.Name, Type = grabbedDataR.Type, UserId = grabbedDataR.UserId, Dist = r2(grabDistR)} or nil
                        local compressedCurlsL = {r2(currentCurlsL[1]), r2(currentCurlsL[2]), r2(currentCurlsL[3]), r2(currentCurlsL[4]), r2(currentCurlsL[5])}
                        local compressedCurlsR = {r2(currentCurlsR[1]), r2(currentCurlsR[2]), r2(currentCurlsR[3]), r2(currentCurlsR[4]), r2(currentCurlsR[5])}
                        local packet = {
                            s = "VR59",
                            u = player.UserId,
                            un = player.Name,
                            st = HAND_STYLE,
                            lp = lpPos, lr = lpRot,
                            rp = rpPos, rr = rpRot,
                            wlp = wlpPos, wlr = wlpRot,
                            wrp = wrpPos, wrr = wrpRot,
                            hp = hpPos, hr = hpRot,
                            gL = (grabbedDataL ~= nil or isClimbingL),
                            gR = (grabbedDataR ~= nil or isClimbingR),
                            cL = isClimbingL,
                            cR = isClimbingR,
                            aL = climbAnchorPosL and {r2(climbAnchorPosL.X), r2(climbAnchorPosL.Y), r2(climbAnchorPosL.Z)} or nil,
                            aR = climbAnchorPosR and {r2(climbAnchorPosR.X), r2(climbAnchorPosR.Y), r2(climbAnchorPosR.Z)} or nil,
                            fL = compressedCurlsL,
                            fR = compressedCurlsR,
                            objL = objLData,
                            objR = objRData,
                            gb = grabPacket
                        }
                        wsConnection:Send(HttpService:JSONEncode(packet))
                    end)
                end
            end
            local interpFactor = 1 - math.exp(-18 * dt)
            for uId, uData in pairs(remoteVRUsers) do
                if tick() - uData.LastTick > 7 then
                    if uData.Folder then uData.Folder:Destroy() end
                    remoteVRUsers[uId] = nil
                    updateNetCountLabel()
                else
                    uData.CurrentL = uData.CurrentL:Lerp(uData.TargetL, interpFactor)
                    uData.CurrentR = uData.CurrentR:Lerp(uData.TargetR, interpFactor)
                    uData.CurrentHead = uData.CurrentHead:Lerp(uData.TargetHead, interpFactor)
                    if uData.Visor then
                        local vf, vg = uData.Visor:FindFirstChild("VisorFrame"), uData.Visor:FindFirstChild("VisorGlass")
                        local vCF = uData.CurrentHead * CFrame.new(0, 0.05, -0.3)
                        if vf then vf.CFrame = vCF end
                        if vg then vg.CFrame = vCF * CFrame.new(0, 0, -0.3) end
                    end
                    local function applyRemotePart(arm, isL, baseCF, isClimbing, wallAnchor, curls)
                        local finalBase = baseCF
                        if isClimbing and wallAnchor then
                            finalBase = CFrame.new(wallAnchor) * (baseCF - baseCF.Position)
                        end
                        local f, c, cr, p, ap = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("CuffRing"), arm:FindFirstChild("Palm"), arm:FindFirstChild("ArmorPlate")
                        if f and c and p then
                            f.CFrame = finalBase * CFrame.new(0, -0.02, 0.40)
                            c.CFrame = finalBase * CFrame.new(0, -0.01, -0.08)
                            if cr then cr.CFrame = finalBase * CFrame.new(0, -0.01, -0.16) end
                            p.CFrame = finalBase * CFrame.new(0, 0, -0.32)
                            if ap then ap.CFrame = finalBase * CFrame.new(0, 0.12, -0.32) end
                            applyFingerKinematics(arm, isL, finalBase, curls or {0.12, 0.12, 0.12, 0.12, 0.12})
                        end
                    end
                    applyRemotePart(uData.Left, true, uData.CurrentL, uData.ClimbL, uData.AnchorL, uData.CurlsL)
                    applyRemotePart(uData.Right, false, uData.CurrentR, uData.ClimbR, uData.AnchorR, uData.CurlsR)
                    local function syncRemoteHeldItem(objData, handCF)
                        if not objData or not objData.Name then return end
                        local target = nil
                        if objData.Type == "PLAYER" and objData.UserId then
                            local p = Players:GetPlayerByUserId(objData.UserId)
                            target = p and p.Character
                        else
                            target = workspace:FindFirstChild(objData.Name, true)
                        end
                        if target and target ~= player.Character then
                            local d = objData.Dist or 4.0
                            local targetCF = handCF * CFrame.new(0, 0, -d)
                            if target:IsA("Model") then
                                target:PivotTo(target:GetPivot():Lerp(targetCF, 0.35))
                            elseif target:IsA("BasePart") then
                                target.CanCollide = false
                                target.CFrame = target.CFrame:Lerp(targetCF, 0.35)
                                target.AssemblyLinearVelocity = Vector3.zero
                            end
                        end
                    end
                    if uData.HeldObjL then syncRemoteHeldItem(uData.HeldObjL, uData.CurrentL) end
                    if uData.HeldObjR then syncRemoteHeldItem(uData.HeldObjR, uData.CurrentR) end
                end
            end
        end)
    end)
end
local function stopVR()
    pcall(function()
        VR_ACTIVE = false
        activeEmoteId = nil
        emoteElapsed = 0
        for _, w in pairs(widgetRegistry) do w.Frame.Visible = false end
        moveForward, moveBackward, moveLeft, moveRight = false, false, false, false
        grabbedDataL, grabbedDataR = nil, nil
        isClimbingL, isClimbingR = false, false
        climbAnchorPosL, climbAnchorPosR = nil, nil
        climbHoldPosition = nil
        camTouchInput, camTouchLastPos = nil, nil
        screenTouchL, screenTouchR = nil, nil
        handDragL, handDragR = Vector3.zero, Vector3.zero
        beingGrabbedBy = nil
        updateGrabBtnVisual(true)
        updateGrabBtnVisual(false)
        if mainLoopConnection then mainLoopConnection:Disconnect() mainLoopConnection = nil end
        if physicsLoopConnection then physicsLoopConnection:Disconnect() physicsLoopConnection = nil end
        cleanupNet()
        netStatus.Text = "⚪ VR: Готов к запуску"
        netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
        camera.CameraType, camera.FieldOfView = Enum.CameraType.Custom, 70
        local curChar = player.Character
        if curChar then
            local humanoid = curChar:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.AutoRotate = true
                humanoid.PlatformStand = false
            end
            for _, item in ipairs(curChar:GetDescendants()) do
                if item:IsA("BasePart") or item:IsA("Decal") then item.LocalTransparencyModifier = 0 end
            end
        end
        if viewmodelFolder then viewmodelFolder:Destroy() viewmodelFolder = nil end
        toggleBtn.Text, toggleBtn.TextColor3, cardStroke.Color = "⏻ ВКЛЮЧИТЬ VR", Color3.fromRGB(0, 255, 180), Color3.fromRGB(0, 255, 180)
    end)
end
toggleBtn.Activated:Connect(function() 
    if VR_ACTIVE then stopVR() else startVR() end 
