local function makeHandPad(isLeft)
    local cont = Instance.new("Frame", screenGui)
    cont.Size, cont.Position = UDim2.new(0, 100, 0, 100), isLeft and UDim2.new(0, 10, 0.38, 0) or UDim2.new(1, -110, 0.38, 0)
    cont.BackgroundTransparency, cont.Active, cont.Visible = 1, true, false
    
    local pad = Instance.new("Frame", cont)
    pad.Size, pad.Position = UDim2.new(0, 72, 0, 72), UDim2.new(0.5, -36, 0.5, -36)
    pad.BackgroundColor3, pad.BackgroundTransparency = Color3.fromRGB(14, 16, 24), 0.2
    Instance.new("UICorner", pad).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke", pad)
    stroke.Thickness, stroke.Color = 1.6, Color3.fromRGB(0, 255, 180)

    local knob = Instance.new("Frame", pad)
    knob.Size, knob.Position = UDim2.new(0, 30, 0, 30), UDim2.new(0.5, -15, 0.5, -15)
    knob.BackgroundColor3 = Color3.fromRGB(0, 255, 180)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    
    local lbl = Instance.new("TextLabel", knob)
    lbl.Size, lbl.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
    lbl.Text, lbl.TextColor3 = isLeft and "L" or "R", Color3.fromRGB(10, 15, 20)
    lbl.Font, lbl.TextSize = Enum.Font.GothamBold, 12

    local drag, tPos = false, nil
    local lastTap = 0

    cont.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            -- Двойной тап = сброс вращения кисти
            if tick() - lastTap < 0.3 then
                if isLeft then wristYawL, wristPitchL = 0, 0 else wristYawR, wristPitchR = 0, 0 end
                stroke.Color = Color3.fromRGB(255, 255, 255)
            else
                stroke.Color = PAD_MODE == "MOVE" and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 100, 200)
            end
            lastTap = tick()
            drag, tPos = true, i.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            if PAD_MODE == "MOVE" then
                local delta = i.Position - tPos
                local vOff = (delta.Magnitude > 0 and delta.Unit or Vector2.zero) * math.clamp(delta.Magnitude, 0, 30)
                knob.Position = UDim2.new(0.5, -15 + vOff.X, 0.5, -15 + vOff.Y)
                
                local vec = Vector3.new(math.clamp(delta.X/38, -0.75, 0.75), math.clamp(-delta.Y/38, -0.75, 0.75), -math.clamp(delta.Magnitude/26, 0, 1.3))
                if isLeft then handDragL = vec else handDragR = vec end
            elseif PAD_MODE == "ROTATE" then
                -- Вращение накапливается от дельты свайпа
                local d = i.Delta
                if isLeft then
                    wristYawL = wristYawL - d.X * 0.015
                    wristPitchL = math.clamp(wristPitchL - d.Y * 0.015, -math.pi, math.pi)
                else
                    wristYawR = wristYawR - d.X * 0.015
                    wristPitchR = math.clamp(wristPitchR - d.Y * 0.015, -math.pi, math.pi)
                end
            end
        end
    end)

    cont.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag, tPos = false, nil
            stroke.Color = Color3.fromRGB(0, 255, 180)
            TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0.5, -15, 0.5, -15)}):Play()
            if isLeft then handDragL = Vector3.zero else handDragR = Vector3.zero end
        end
    end)
    return cont
end
local handPadL, handPadR = makeHandPad(true), makeHandPad(false)

-- // 4. СОЗДАНИЕ ГЛАДКИХ РУК
local function buildArm(isLeft)
    local m = Instance.new("Model")
    m.Name = isLeft and "VR_L" or "VR_R"
    
    local c, cuffC, mat = Color3.fromRGB(225, 185, 145), Color3.fromRGB(0, 255, 180), Enum.Material.SmoothPlastic
    if HAND_STYLE == 2 then c, cuffC, mat = Color3.fromRGB(20, 22, 28), Color3.fromRGB(0, 230, 255), Enum.Material.Neon
    elseif HAND_STYLE == 3 then c, cuffC = Color3.fromRGB(35, 35, 40), Color3.fromRGB(255, 60, 60) end

    local function mk(name, sz, col, mt)
        local p = Instance.new("Part")
        p.Name, p.Size, p.Color, p.Material = name, sz, col, mt
        p.TopSurface, p.BottomSurface, p.LeftSurface, p.RightSurface, p.FrontSurface, p.BackSurface = 0,0,0,0,0,0
        p.CanCollide, p.CanTouch, p.CanQuery, p.Anchored, p.CastShadow = false, false, false, true, false
        p.Parent = m
        return p
    end

    mk("Forearm", Vector3.new(0.48, 0.48, 1.1), c, mat)
    mk("Cuff", Vector3.new(0.52, 0.52, 0.1), cuffC, Enum.Material.Neon)
    mk("Palm", Vector3.new(0.44, 0.35, 0.5), c, mat)
    mk("Fingers", Vector3.new(0.42, 0.28, 0.3), c, mat)
    
    m.Parent = viewmodelFolder
    return m
end

local function setupHands()
    if viewmodelFolder then viewmodelFolder:Destroy() end
    viewmodelFolder = Instance.new("Folder")
    viewmodelFolder.Name = "VR_Rig"
    viewmodelFolder.Parent = camera
    leftArmModel, rightArmModel = buildArm(true), buildArm(false)
end

-- // 5. КАМЕРА И AIM-TO-TOUCH
UserInputService.InputBegan:Connect(function(input, processed)
    if not VR_ACTIVE then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local posX = input.Position.X
        if posX > camera.ViewportSize.X * 0.42 and not processed then
            cameraTouchInput = input
        end
        local ray = camera:ViewportPointToRay(input.Position.X, input.Position.Y)
        local localDir = camera.CFrame:VectorToObjectSpace(ray.Direction).Unit
        local aimRot = CFrame.lookAt(Vector3.zero, localDir)
        if posX < camera.ViewportSize.X * 0.5 then
            tapReachL, tapRotL, tapAlphaL = localDir * 1.4, aimRot, 1
        else
            tapReachR, tapRotR, tapAlphaR = localDir * 1.4, aimRot, 1
        end
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if VR_ACTIVE and input == cameraTouchInput then
        local delta = input.Delta
        if delta.Magnitude > 0 then
            touchYaw = touchYaw - delta.X * (0.004 * SENS_MULTIPLIER)
            touchPitch = math.clamp(touchPitch - delta.Y * (0.004 * SENS_MULTIPLIER), math.rad(-75), math.rad(75))
        end
    end
end)
UserInputService.InputEnded:Connect(function(input) if input == cameraTouchInput then cameraTouchInput = nil end end)
if UserInputService.GyroscopeEnabled then
    gyroConnection = UserInputService.DeviceRotationChanged:Connect(function(_, rotCFrame) rawGyroCF = rotCFrame end)
end

-- // 6. ГЛАВНЫЙ ЦИКЛ VR (ИДЕАЛЬНАЯ МАТЕМАТИКА ХОДЬБЫ)
local function startVR()
    VR_ACTIVE = true
    camera.CameraType = Enum.CameraType.Scriptable
    dpadFrame.Visible, handPadL.Visible, handPadR.Visible = true, true, true
    baseGyroCF, smoothedCamRot, lastCamCF = rawGyroCF, CFrame.identity, camera.CFrame
    touchYaw, touchPitch = 0, 0
    camera.FieldOfView = FOV_MODES[FOV_INDEX]
    setupHands()

    toggleBtn.Text, toggleBtn.TextColor3 = "⏻ ВЫКЛЮЧИТЬ VR", Color3.fromRGB(255, 80, 80)
    cardStroke.Color = Color3.fromRGB(255, 80, 80)

    -- Поворот тела (FE)
    physicsLoopConnection = RunService.Stepped:Connect(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if char and root and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid").AutoRotate = false
            local look = camera.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude > 0.05 then
                root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, root.Position + flatLook.Unit), 0.35)
            end
        end
    end)

    mainLoopConnection = RunService.RenderStepped:Connect(function(dt)
        local char = player.Character
        if not char then return end

        -- ZERO GHOST: Скрытие оригинального тела
        for _, item in ipairs(char:GetDescendants()) do
            if item:IsA("BasePart") and not item:IsDescendantOf(char:FindFirstChildOfClass("Tool") or game) then
                item.LocalTransparencyModifier = 1
            end
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")
        if not head or not root or not humanoid then return end

        -- 1. ИДЕАЛЬНАЯ ХОДЬБА (Извлечение чистого Yaw от камеры)
        if not EDITING_DPAD then
            local moveZ = (moveForward and -1 or 0) + (moveBackward and 1 or 0) -- -1 это вперед по оси локальной Z
            local moveX = (moveRight and 1 or 0) + (moveLeft and -1 or 0)
            
            if moveZ ~= 0 or moveX ~= 0 then
                -- Берем угол поворота камеры по Y (Yaw)
                local _, camYaw, _ = camera.CFrame:ToEulerAnglesYXZ()
                local camRot = CFrame.Angles(0, camYaw, 0)
                
                -- Вектор направления движения: переводим локальные нажатия в мировые координаты
                local moveDir = camRot * Vector3.new(moveX, 0, moveZ)
                if moveDir.Magnitude > 0.01 then
                    humanoid:Move(moveDir.Unit, false)
                end
            else
                humanoid:Move(Vector3.zero, false)
            end
        end

        -- 2. Камера
        local targetRot
        if CONTROL_MODE == "GYRO" then
            local rx, ry, rz = baseGyroCF:ToObjectSpace(rawGyroCF):ToOrientation()
            targetRot = CFrame.Angles(0, -rz + touchYaw, 0) * CFrame.Angles(math.clamp(-rx, math.rad(-75), math.rad(75)) + touchPitch, 0, 0)
        else
            targetRot = CFrame.Angles(0, touchYaw, 0) * CFrame.Angles(touchPitch, 0, 0)
        end
        smoothedCamRot = smoothedCamRot:Lerp(targetRot, 0.4)
        camera.CFrame = CFrame.new(head.Position + Vector3.new(0, IS_CROUCHING and -1.4 or 0.25, 0)) * smoothedCamRot
        local camCF = camera.CFrame

        -- 3. Инерция и шаги
        local dRot = camCF:ToObjectSpace(lastCamCF)
        swayCF = swayCF:Lerp(CFrame.Angles(math.clamp(dRot.X*0.5, -0.12, 0.12), math.clamp(dRot.Y*0.5, -0.12, 0.12), 0), 0.25)
        lastCamCF = camCF

        bobStep = bobStep + dt * (root.AssemblyLinearVelocity.Magnitude > 1 and 8 or 2.5)
        local bobX, bobY = math.sin(bobStep)*0.02, math.cos(bobStep*2)*0.015

        tapAlphaL, tapAlphaR = math.clamp(tapAlphaL - dt*4, 0, 1), math.clamp(tapAlphaR - dt*4, 0, 1)
        currentHandOffsetL = currentHandOffsetL:Lerp(handDragL + (tapReachL * tapAlphaL), 0.28)
        currentHandOffsetR = currentHandOffsetR:Lerp(handDragR + (tapReachR * tapAlphaR), 0.28)

        -- 4. Рендер кистей с учетом вращения (Wrist Rotation)
        local function updateArm(arm, isL, off, tRot, tAlpha, wPitch, wYaw)
            if not arm then return end
            local side = isL and -1 or 1
            
            -- Дефолтный угол + наклон пользователя (Wrist Rotation)
            local userWrist = CFrame.Angles(wPitch, wYaw, 0)
            local baseAngle = CFrame.Angles(math.rad(12 - off.Z*20 + off.Y*16), math.rad(-side*8 + off.X*20), math.rad(side*4)) * userWrist
            local finalAngle = baseAngle:Lerp(tRot, tAlpha*0.8)

            local base = camCF * swayCF * CFrame.new(side*(0.65 - (side*bobX)) + off.X, -0.65 + bobY + off.Y, -1.05 + off.Z) * finalAngle

            local f, c, p, fg = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("Palm"), arm:FindFirstChild("Fingers")
            if f and c and p and fg then
                f.CFrame = base * CFrame.new(0, 0, 0.35)
                c.CFrame = base * CFrame.new(0, 0, -0.22)
                p.CFrame = base * CFrame.new(0, -0.02, -0.5) * CFrame.Angles(math.rad(8), 0, 0)
                fg.CFrame = base * CFrame.new(0, -0.05, -0.85) * CFrame.Angles(math.rad(18), 0, 0)
            end
        end

        updateArm(leftArmModel, true, currentHandOffsetL, tapRotL, tapAlphaL, wristPitchL, wristYawL)
        updateArm(rightArmModel, false, currentHandOffsetR, tapRotR, tapAlphaR, wristPitchR, wristYawR)

        -- 5. ИДЕАЛЬНЫЙ GRIP ПРЕДМЕТА В РУКЕ
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local rightGrip = nil
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("Weld") and v.Name == "RightGrip" then rightGrip = v break end
            end
            local vrPalm = rightArmModel and rightArmModel:FindFirstChild("Palm")
            if rightGrip and vrPalm then
                rightGrip.Part0 = vrPalm
                rightGrip.C0 = CFrame.new(0, -0.1, -0.3) * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end
    end)
end

local function stopVR()
    VR_ACTIVE = false
    dpadFrame.Visible, handPadL.Visible, handPadR.Visible = false, false, false
    moveForward, moveBackward, moveLeft, moveRight = false, false, false, false
    if mainLoopConnection then mainLoopConnection:Disconnect() mainLoopConnection = nil end
    if physicsLoopConnection then physicsLoopConnection:Disconnect() physicsLoopConnection = nil end

    camera.CameraType, camera.FieldOfView = Enum.CameraType.Custom, 70
    local char = player.Character
    if char then
        if char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid").AutoRotate = true end
        for _, item in ipairs(char:GetDescendants()) do if item:IsA("BasePart") then item.LocalTransparencyModifier = 0 end end
    end
    if viewmodelFolder then viewmodelFolder:Destroy() viewmodelFolder = nil end
    toggleBtn.Text, toggleBtn.TextColor3, cardStroke.Color = "⏻ ВКЛЮЧИТЬ VR", Color3.fromRGB(0, 255, 180), Color3.fromRGB(0, 255, 180)
end

