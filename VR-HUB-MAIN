local function applyStyleToModel(model, styleIndex, targetPlayer)
    local st = STYLES[styleIndex or 1]
    local baseCol = st.Col
    local cuffCol = st.Cuff
    local mat = st.Mat
    local lightCol = st.Light or cuffCol

    if styleIndex == 1 then
        local targetChar = targetPlayer and targetPlayer.Character or player.Character
        local bodyPart = targetChar and (targetChar:FindFirstChild("LeftHand") or targetChar:FindFirstChild("Left Arm") or targetChar:FindFirstChild("Head"))
        baseCol = bodyPart and bodyPart.Color or Color3.fromRGB(225, 185, 145)
    end

    for _, p in ipairs(model:GetChildren()) do
        if p:IsA("BasePart") then
            if p.Name == "Cuff" then
                p.Color = cuffCol
                p.Material = Enum.Material.Neon
                local light = p:FindFirstChildOfClass("PointLight")
                if light then light.Color = lightCol end
            else
                p.Color = baseCol or Color3.fromRGB(225, 185, 145)
                p.Material = mat
            end
        end
    end
end

local function buildArm(isLeft, targetFolder, customStyle, targetPlayer)
    local m = Instance.new("Model")
    m.Name = isLeft and "VR_L" or "VR_R"

    local function mk(name, sz)
        local p = Instance.new("Part")
        p.Name, p.Size = name, sz
        p.TopSurface, p.BottomSurface, p.LeftSurface, p.RightSurface, p.FrontSurface, p.BackSurface = 0,0,0,0,0,0
        p.CanCollide, p.CanTouch, p.CanQuery, p.Anchored, p.CastShadow, p.Parent = false, false, false, true, false, m
        return p
    end

    mk("Forearm", Vector3.new(0.52, 0.42, 1.05))
    local cuff = mk("Cuff", Vector3.new(0.56, 0.46, 0.14))
    mk("Palm", Vector3.new(0.48, 0.30, 0.52))
    mk("Fingers", Vector3.new(0.44, 0.20, 0.32))
    mk("Thumb", Vector3.new(0.16, 0.20, 0.26))

    -- Премиум подсветка кистей
    local ptLight = Instance.new("PointLight", cuff)
    ptLight.Range = 4.5
    ptLight.Brightness = 1.4
    ptLight.Shadows = false

    applyStyleToModel(m, customStyle or HAND_STYLE, targetPlayer or player)
    m.Parent = targetFolder or viewmodelFolder
    return m
end

