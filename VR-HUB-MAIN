local function buildHandPad(cont, isLeft)
    local pad = Instance.new("Frame", cont)
    pad.Size, pad.Position = UDim2.new(0, 76, 0, 76), UDim2.new(0.5, -38, 0.5, -38)
    pad.BackgroundColor3, pad.BackgroundTransparency = Color3.fromRGB(14, 16, 24), 0.2
    Instance.new("UICorner", pad).CornerRadius = UDim.new(1, 0)
    local pStroke = Instance.new("UIStroke", pad)
    pStroke.Thickness, pStroke.Color = 1.6, Color3.fromRGB(0, 255, 180)

    local knob = Instance.new("Frame", pad)
    knob.Size, knob.Position = UDim2.new(0, 32, 0, 32), UDim2.new(0.5, -16, 0.5, -16)
    knob.BackgroundColor3 = Color3.fromRGB(0, 255, 180)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local lbl = Instance.new("TextLabel", knob)
    lbl.Size, lbl.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
    lbl.Text, lbl.TextColor3, lbl.Font, lbl.TextSize = isLeft and "L" or "R", Color3.fromRGB(10, 15, 20), Enum.Font.GothamBold, 12

    local dragInput, tPos, lastTap = nil, nil, 0
    cont.InputBegan:Connect(function(i)
        if not EDITING_UI and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1) then
            if tick() - lastTap < 0.28 then
                if isLeft then wristYawL, wristPitchL = 0, 0 else wristYawR, wristPitchR = 0, 0 end
            end
            lastTap, dragInput, tPos = tick(), i, i.Position
            pStroke.Color = PAD_MODE == "MOVE" and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 100, 220)
        end
    end)

    UserInputService.InputChanged:Connect(function(i)
        if dragInput and i == dragInput and not EDITING_UI then
            local delta = i.Position - tPos
            if PAD_MODE == "MOVE" then
                local vOff = (delta.Magnitude > 0 and delta.Unit or Vector2.zero) * math.clamp(delta.Magnitude, 0, 32)
                knob.Position = UDim2.new(0.5, -16 + vOff.X, 0.5, -16 + vOff.Y)
                local vec = Vector3.new(math.clamp(delta.X / 32, -0.7, 0.7), math.clamp(-delta.Y / 32, -0.7, 0.7), -math.clamp(delta.Magnitude / 20, 0, 1.3))
                if isLeft then handDragL = vec else handDragR = vec end
            elseif PAD_MODE == "ROTATE" then
                local mult = 0.022
                if isLeft then
                    wristYawL = wristYawL - i.Delta.X * mult
                    wristPitchL = math.clamp(wristPitchL - i.Delta.Y * mult, -math.pi, math.pi)
                else
                    wristYawR = wristYawR - i.Delta.X * mult
                    wristPitchR = math.clamp(wristPitchR - i.Delta.Y * mult, -math.pi, math.pi)
                end
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(i)
        if dragInput and i == dragInput then
            dragInput, tPos, pStroke.Color = nil, nil, Color3.fromRGB(0, 255, 180)
            TweenService:Create(knob, TweenInfo.new(0.12), {Position = UDim2.new(0.5, -16, 0.5, -16)}):Play()
            if isLeft then handDragL = Vector3.zero else handDragR = Vector3.zero end
        end
    end)
end
