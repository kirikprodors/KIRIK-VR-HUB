local function isNaN(n) return n ~= n end
local function safeVec3(v, fallback)
    fallback = fallback or Vector3.zero
    if not v or isNaN(v.X) or isNaN(v.Y) or isNaN(v.Z) then return fallback end
    return v
end
local function safeUnit(v, fallback)
    fallback = fallback or Vector3.new(0, 0, -1)
    if not v or isNaN(v.X) or isNaN(v.Y) or isNaN(v.Z) or v.Magnitude < 1e-4 then return fallback end
    return v.Unit
end
local function safeLookAt(eye, target, fallbackDir)
    fallbackDir = fallbackDir or Vector3.new(0, 0, -1)
    eye = safeVec3(eye, Vector3.zero)
    target = safeVec3(target, eye + fallbackDir)
    local dir = target - eye
    if dir.Magnitude < 1e-4 or isNaN(dir.X) then dir = fallbackDir end
    return CFrame.lookAt(eye, eye + dir.Unit)
end
