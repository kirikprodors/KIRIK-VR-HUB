    if viewmodelFolder then viewmodelFolder:Destroy() end
    viewmodelFolder = Instance.new("Folder")
    viewmodelFolder.Name = "VR_Rig"
    viewmodelFolder.Parent = camera
    leftArmModel, rightArmModel = buildArm(true), buildArm(false)
end

-- // 6. СЕТЕВОЙ МОДУЛЬ (BODY-ROOT SYNC)
local function getWebSocketFunc()
    if syn and type(syn.websocket) == "table" and type(syn.websocket.connect) == "function" then
        return syn.websocket.connect
    elseif WebSocket and type(WebSocket.connect) == "function" then
        return WebSocket.connect
    elseif websocket and type(websocket.connect) == "function" then
        return websocket.connect
    elseif Krnl and Krnl.WebSocket and type(Krnl.WebSocket.connect) == "function" then
        return Krnl.WebSocket.connect
    end
    return nil
end

local function cleanupNet()
    if heartbeatThread then task.cancel(heartbeatThread) heartbeatThread = nil end
    if wsConnection then pcall(function() wsConnection:Close() end) wsConnection = nil end
    for _, u in pairs(remoteVRUsers) do if u.Folder then u.Folder:Destroy() end end
    remoteVRUsers = {}
    isConnectingNet = false
end

local function startNetworkSync()
    cleanupNet()
    if not NETWORK_ENABLED or not VR_ACTIVE then
        netStatus.Text = "🟢 VR: Активен | ⚪ Сеть выключена"
        netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
        return
    end

    netAttemptId = netAttemptId + 1
    local thisAttempt = netAttemptId
    isConnectingNet = true

    task.spawn(function()
        pcall(function()
            local wsConnect = getWebSocketFunc()
            if not wsConnect then
                netStatus.Text = "🟢 VR: Активен | ⚪ Одиночный (Чит без WS API)"
                netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
                isConnectingNet = false
                return
            end

            netStatus.Text = "🟢 VR: Активен | 🟡 Подключение к серверу..."
            netStatus.TextColor3 = Color3.fromRGB(255, 215, 0)

            local ok, ws = pcall(function() return wsConnect(MY_PRIVATE_WS_URL) end)
            if ok and ws and thisAttempt == netAttemptId and VR_ACTIVE and NETWORK_ENABLED then
                wsConnection = ws
                netStatus.Text = "🟢 VR: Активен | 🟢 VR СЕТЬ: Онлайн"
                netStatus.TextColor3 = Color3.fromRGB(0, 255, 180)

                heartbeatThread = task.spawn(function()
                    while wsConnection and VR_ACTIVE and NETWORK_ENABLED do
                        task.wait(15)
                        pcall(function() wsConnection:Send(HttpService:JSONEncode({s = "PING"})) end)
                    end
                end)

                wsConnection.OnMessage:Connect(function(msg)
                    pcall(function()
                        local data = HttpService:JSONDecode(msg)
                        if type(data) == "table" and data.s == "VR39" and data.u ~= player.UserId then
                            local remotePlr = Players:GetPlayerByUserId(data.u)
                            if remotePlr and remotePlr.Character and remotePlr.Character:FindFirstChild("HumanoidRootPart") then
                                if not remoteVRUsers[data.u] then
                                    local rFolder = Instance.new("Folder", workspace)
                                    rFolder.Name = "RemoteVR_" .. data.u
                                    remoteVRUsers[data.u] = {
                                        Folder = rFolder,
                                        Left = buildArm(true, rFolder, data.st, remotePlr),
                                        Right = buildArm(false, rFolder, data.st, remotePlr),
                                        Style = data.st,
                                        TargetL = CFrame.identity,
                                        TargetR = CFrame.identity,
                                        CurrentL = CFrame.identity,
                                        CurrentR = CFrame.identity,
                                        LastTick = tick()
                                    }
                                end

                                local u = remoteVRUsers[data.u]
                                u.LastTick = tick()

                                if u.Style ~= data.st then
                                    u.Style = data.st
                                    applyStyleToModel(u.Left, data.st, remotePlr)
                                    applyStyleToModel(u.Right, data.st, remotePlr)
                                end

                                if data.lp and data.lr and data.rp and data.rr then
                                    local rootCF = remotePlr.Character.HumanoidRootPart.CFrame
                                    local localLCF = CFrame.new(unpack(data.lp)) * CFrame.Angles(unpack(data.lr))
                                    local localRCF = CFrame.new(unpack(data.rp)) * CFrame.Angles(unpack(data.rr))

                                    -- Руки привязываются к телу персонажа в мире
                                    u.TargetL = rootCF * localLCF
                                    u.TargetR = rootCF * localRCF
                                end
                            end
                        end
                    end)
                end)

                wsConnection.OnClose:Connect(function()
                    cleanupNet()
                    if VR_ACTIVE and NETWORK_ENABLED then
                        netStatus.Text = "🟢 VR: Активен | ⚪ Одиночный режим"
                        netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
                    end
                end)
            else
                cleanupNet()
                if VR_ACTIVE then
                    netStatus.Text = "🟢 VR: Активен | ⚪ Одиночный режим"
                    netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
                end
            end
            isConnectingNet = false
        end)
    end)
end

-- // 7. ВВОД КАМЕРЫ И ТАПЫ
UserInputService.InputBegan:Connect(function(input, processed)
    if not VR_ACTIVE or processed or EDITING_UI then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local ray = camera:ViewportPointToRay(input.Position.X, input.Position.Y)
        local localDir = camera.CFrame:VectorToObjectSpace(ray.Direction).Unit
        local aimRot = CFrame.lookAt(Vector3.zero, localDir)
        if input.Position.X < camera.ViewportSize.X * 0.5 then
            tapReachL, tapRotL, tapAlphaL = localDir * 1.3, aimRot, 1
        else
            tapReachR, tapRotR, tapAlphaR = localDir * 1.3, aimRot, 1
        end
    end
end)

UserInputService.InputChanged:Connect(function(input, processed)
    if not VR_ACTIVE or EDITING_UI then return end
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
        if input.Position.X > camera.ViewportSize.X * 0.35 then
            local delta = input.Delta
            if delta.Magnitude > 0 then
                touchYaw = touchYaw - delta.X * (0.0035 * SENS_MULTIPLIER)
                touchPitch = math.clamp(touchPitch - delta.Y * (0.0035 * SENS_MULTIPLIER), math.rad(-75), math.rad(75))
            end
        end
    end
end)

if UserInputService.GyroscopeEnabled then
    gyroConnection = UserInputService.DeviceRotationChanged:Connect(function(_, rotCFrame) rawGyroCF = rotCFrame end)
end

-- // 8. ГЛАВНЫЙ ЦИКЛ РЕНДЕРА
local function startVR()
    VR_ACTIVE = true
    camera.CameraType = Enum.CameraType.Scriptable
    dpadContainer.Visible, handContL.Visible, handContR.Visible = true, true, true

    baseGyroCF, smoothedCamRot, lastCamCF = rawGyroCF, CFrame.identity, camera.CFrame
    touchYaw, touchPitch = 0, 0
    camera.FieldOfView = FOV_MODES[FOV_INDEX]
    
    setupHands()
    startNetworkSync()

    toggleBtn.Text, toggleBtn.TextColor3 = "⏻ ВЫКЛЮЧИТЬ VR", Color3.fromRGB(255, 80, 80)
    cardStroke.Color = Color3.fromRGB(255, 80, 80)

    physicsLoopConnection = RunService.Stepped:Connect(function()
        pcall(function()
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if char and root and char:FindFirstChildOfClass("Humanoid") then
                char:FindFirstChildOfClass("Humanoid").AutoRotate = false
                local look = camera.CFrame.LookVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                if flatLook.Magnitude > 0.05 then
                    root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, root.Position + flatLook.Unit), 0.35)
                end
            end
        end)
    end)

    mainLoopConnection = RunService.RenderStepped:Connect(function(dt)
        pcall(function()
            local char = player.Character
            if not char then return end

            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local head = char:FindFirstChild("Head")
            if not head or not root or not humanoid then return end

            -- Скрытие тела
            local currentTool = char:FindFirstChildOfClass("Tool")
            for _, item in ipairs(char:GetDescendants()) do
                if item:IsA("BasePart") or item:IsA("Decal") then
                    if currentTool and item:IsDescendantOf(currentTool) then
                        item.LocalTransparencyModifier = 0
                    else
                        item.LocalTransparencyModifier = 1
                    end
                end
            end

            -- Ходьба
            if not EDITING_UI then
                local moveZ = (moveForward and -1 or 0) + (moveBackward and 1 or 0)
                local moveX = (moveRight and 1 or 0) + (moveLeft and -1 or 0)
                if moveZ ~= 0 or moveX ~= 0 then
                    local _, camYaw, _ = camera.CFrame:ToEulerAnglesYXZ()
                    local moveDir = CFrame.Angles(0, camYaw, 0) * Vector3.new(moveX, 0, moveZ)
                    humanoid:Move(moveDir.Unit, false)
                else
                    humanoid:Move(Vector3.zero, false)
                end
            end

            -- Камера
            local targetRot
            if CONTROL_MODE == "GYRO" then
                local rx, ry, rz = baseGyroCF:ToObjectSpace(rawGyroCF):ToEulerAnglesYXZ()
                targetRot = CFrame.Angles(0, -rz + touchYaw, 0) * CFrame.Angles(math.clamp(-rx, math.rad(-75), math.rad(75)) + touchPitch, 0, 0)
            else
                targetRot = CFrame.Angles(0, touchYaw, 0) * CFrame.Angles(touchPitch, 0, 0)
            end

            smoothedCamRot = smoothedCamRot:Lerp(targetRot, 0.4)

            -- Физика шагов и подъем камеры
            local isMoving = root.AssemblyLinearVelocity.Magnitude > 1.5
            bobStep = bobStep + dt * (isMoving and 8.5 or 2.2)
            local bobX, bobY = math.sin(bobStep) * 0.018, math.cos(bobStep * 2) * 0.012

            local camWalkLift = isMoving and (math.abs(math.sin(bobStep)) * 0.12) or 0
            local camTiltRoll = isMoving and (math.sin(bobStep) * 0.014) or 0
            local headBaseHeight = IS_CROUCHING and -1.4 or 0.25

            camera.CFrame = CFrame.new(head.Position + Vector3.new(0, headBaseHeight + camWalkLift, 0)) 
                * smoothedCamRot 
                * CFrame.Angles(0, 0, camTiltRoll)
                
            local camCF = camera.CFrame

            -- Инерция рук
            local dRot = camCF:ToObjectSpace(lastCamCF)
            swayCF = swayCF:Lerp(CFrame.Angles(math.clamp(dRot.X * 0.4, -0.08, 0.08), math.clamp(dRot.Y * 0.4, -0.08, 0.08), 0), 0.25)
            lastCamCF = camCF

            tapAlphaL = math.clamp(tapAlphaL - dt * 4, 0, 1)
            tapAlphaR = math.clamp(tapAlphaR - dt * 4, 0, 1)

            currentHandOffsetL = currentHandOffsetL:Lerp(handDragL + (tapReachL * tapAlphaL), 0.28)
            currentHandOffsetR = currentHandOffsetR:Lerp(handDragR + (tapReachR * tapAlphaR), 0.28)

            local finalLeftCF, finalRightCF = nil, nil

            local function updateArm(arm, isL, off, tRot, tAlpha, wPitch, wYaw)
                if not arm then return end
                local side = isL and -1 or 1
                local userWrist = CFrame.Angles(wPitch, wYaw, 0)
                local baseAngle = CFrame.Angles(math.rad(-10 + off.Y * 18 - off.Z * 12), math.rad(-side * 6 + off.X * 16), math.rad(side * 5)) * userWrist
                local finalAngle = baseAngle:Lerp(tRot, tAlpha * 0.8)

                local base = camCF * swayCF * CFrame.new(side * (0.62 - (side * bobX)) + off.X, -0.56 + bobY + off.Y, -1.02 + off.Z) * finalAngle
                if isL then finalLeftCF = base else finalRightCF = base end

                local f, c, p, fg, th = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("Palm"), arm:FindFirstChild("Fingers"), arm:FindFirstChild("Thumb")
                if f and c and p and fg then
                    f.CFrame = base * CFrame.new(0, -0.02, 0.40)
                    c.CFrame = base * CFrame.new(0, -0.01, -0.08)
                    p.CFrame = base * CFrame.new(0, 0, -0.32)
                    fg.CFrame = base * CFrame.new(0, -0.03, -0.62) * CFrame.Angles(math.rad(-10), 0, 0)
                    if th then th.CFrame = base * CFrame.new(side * 0.22, -0.02, -0.30) * CFrame.Angles(0, math.rad(side * 28), math.rad(side * 10)) end
                end
            end

            updateArm(leftArmModel, true, currentHandOffsetL, tapRotL, tapAlphaL, wristPitchL, wristYawL)
            updateArm(rightArmModel, false, currentHandOffsetR, tapRotR, tapAlphaR, wristPitchR, wristYawR)

            -- Двуручный хват
            if currentTool then
                local rightGrip = nil
                for _, v in ipairs(char:GetDescendants()) do if v:IsA("Weld") and v.Name == "RightGrip" then rightGrip = v break end end
                local vrPalmR = rightArmModel and rightArmModel:FindFirstChild("Palm")
                local vrPalmL = leftArmModel and leftArmModel:FindFirstChild("Palm")

                if rightGrip and vrPalmR then
                    if TWO_HAND_MODE and vrPalmL then
                        local aimVector = (vrPalmR.Position - vrPalmL.Position)
                        if aimVector.Magnitude > 0.05 then
                            local lookRotation = CFrame.lookAt(vrPalmR.Position, vrPalmR.Position + aimVector.Unit)
                            rightGrip.Part0 = vrPalmR
                            rightGrip.C0 = vrPalmR.CFrame:ToObjectSpace(lookRotation) * CFrame.Angles(math.rad(-90), 0, math.rad(90))
                            rightGrip.C1 = currentTool.Grip
                        end
                    else
                        rightGrip.Part0, rightGrip.C0, rightGrip.C1 = vrPalmR, CFrame.new(0, -0.05, -0.15) * CFrame.Angles(math.rad(-90), 0, 0), currentTool.Grip
                    end
                end
            end

            -- Отправка относительных координат (Body-Root Space)
            if NETWORK_ENABLED and wsConnection and tick() - lastNetSend > 0.05 and finalLeftCF and finalRightCF then
                lastNetSend = tick()
                pcall(function()
                    local rootCF = root.CFrame
                    local relL = rootCF:ToObjectSpace(finalLeftCF)
                    local relR = rootCF:ToObjectSpace(finalRightCF)

                    local packet = {
                        s = "VR39",
                        u = player.UserId,
                        st = HAND_STYLE,
                        lp = {relL.Position.X, relL.Position.Y, relL.Position.Z},
                        lr = {relL:ToEulerAnglesXYZ()},
                        rp = {relR.Position.X, relR.Position.Y, relR.Position.Z},
                        rr = {relR:ToEulerAnglesXYZ()}
                    }
                    wsConnection:Send(HttpService:JSONEncode(packet))
                end)
            end

            -- Плавная интерполяция 60 FPS для чужих рук
            for uId, uData in pairs(remoteVRUsers) do
                if tick() - uData.LastTick > 4 then
                    if uData.Folder then uData.Folder:Destroy() end
                    remoteVRUsers[uId] = nil
                else
                    uData.CurrentL = uData.CurrentL:Lerp(uData.TargetL, 0.35)
                    uData.CurrentR = uData.CurrentR:Lerp(uData.TargetR, 0.35)

                    local function applyRemotePart(arm, isL, baseCF)
                        local f, c, p, fg, th = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("Palm"), arm:FindFirstChild("Fingers"), arm:FindFirstChild("Thumb")
                        local side = isL and -1 or 1
                        if f and c and p and fg then
                            f.CFrame = baseCF * CFrame.new(0, -0.02, 0.40)
                            c.CFrame = baseCF * CFrame.new(0, -0.01, -0.08)
                            p.CFrame = baseCF * CFrame.new(0, 0, -0.32)
                            fg.CFrame = baseCF * CFrame.new(0, -0.03, -0.62) * CFrame.Angles(math.rad(-10), 0, 0)
                            if th then th.CFrame = baseCF * CFrame.new(side * 0.22, -0.02, -0.30) * CFrame.Angles(0, math.rad(side * 28), math.rad(side * 10)) end
                        end
                    end

                    applyRemotePart(uData.Left, true, uData.CurrentL)
                    applyRemotePart(uData.Right, false, uData.CurrentR)
                end
            end
        end)
    end)
end

local function stopVR()
    pcall(function()
        VR_ACTIVE = false
        dpadContainer.Visible, handContL.Visible, handContR.Visible = false, false, false
        moveForward, moveBackward, moveLeft, moveRight = false, false, false, false

        if mainLoopConnection then mainLoopConnection:Disconnect() mainLoopConnection = nil end
        if physicsLoopConnection then physicsLoopConnection:Disconnect() physicsLoopConnection = nil end
        cleanupNet()

        netStatus.Text = "⚪ VR: Готов к запуску"
        netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)

        camera.CameraType, camera.FieldOfView = Enum.CameraType.Custom, 70
        local char = player.Character
        if char then
            if char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid").AutoRotate = true end
            for _, item in ipairs(char:GetDescendants()) do
                if item:IsA("BasePart") or item:IsA("Decal") then
                    item.LocalTransparencyModifier = 0
                end
            end
        end
        if viewmodelFolder then viewmodelFolder:Destroy() viewmodelFolder = nil end
        toggleBtn.Text, toggleBtn.TextColor3, cardStroke.Color = "⏻ ВКЛЮЧИТЬ VR", Color3.fromRGB(0, 255, 180), Color3.fromRGB(0, 255, 180)
    end)
end

