local function buildHandPad(cont, isLeft)
    local pad = Instance.new("Frame", cont)
    pad.Size, pad.Position, pad.BackgroundColor3, pad.BackgroundTransparency = UDim2.new(0,72,0,72), UDim2.new(0.5,-36,0.5,-36), Color3.fromRGB(14,16,24), 0.2
    Instance.new("UICorner", pad).CornerRadius = UDim.new(1,0)
    local pStroke = Instance.new("UIStroke", pad)
    pStroke.Thickness, pStroke.Color = 1.6, Color3.fromRGB(0,255,180)

    local knob = Instance.new("Frame", pad)
    knob.Size, knob.Position, knob.BackgroundColor3 = UDim2.new(0,30,0,30), UDim2.new(0.5,-15,0.5,-15), Color3.fromRGB(0,255,180)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
    local lbl = Instance.new("TextLabel", knob)
    lbl.Size, lbl.BackgroundTransparency, lbl.Text, lbl.TextColor3, lbl.Font, lbl.TextSize = UDim2.new(1,0,1,0), 1, isLeft and "L" or "R", Color3.fromRGB(10,15,20), Enum.Font.GothamBold, 12

    local drag, tPos, lastTap = false, nil, 0
    cont.InputBegan:Connect(function(i)
        if not EDITING_UI and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1) then
            if tick() - lastTap < 0.3 then
                if isLeft then wristYawL, wristPitchL = 0, 0 else wristYawR, wristPitchR = 0, 0 end
                pStroke.Color = Color3.fromRGB(255, 255, 255)
            else
                pStroke.Color = PAD_MODE == "MOVE" and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 100, 200)
            end
            lastTap, drag, tPos = tick(), true, i.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and not EDITING_UI and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = i.Position - tPos
            if PAD_MODE == "MOVE" then
                local vOff = (delta.Magnitude > 0 and delta.Unit or Vector2.zero) * math.clamp(delta.Magnitude, 0, 30)
                knob.Position = UDim2.new(0.5, -15 + vOff.X, 0.5, -15 + vOff.Y)
                local vec = Vector3.new(math.clamp(delta.X/38, -0.75, 0.75), math.clamp(-delta.Y/38, -0.75, 0.75), -math.clamp(delta.Magnitude/26, 0, 1.3))
                if isLeft then handDragL = vec else handDragR = vec end
            elseif PAD_MODE == "ROTATE" then
                if isLeft then wristYawL = wristYawL - i.Delta.X*0.015; wristPitchL = math.clamp(wristPitchL - i.Delta.Y*0.015, -math.pi, math.pi)
                else wristYawR = wristYawR - i.Delta.X*0.015; wristPitchR = math.clamp(wristPitchR - i.Delta.Y*0.015, -math.pi, math.pi) end
            end
        end
    end)
    local function rel()
        drag, tPos, pStroke.Color = false, nil, Color3.fromRGB(0, 255, 180)
        TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0.5,-15,0.5,-15)}):Play()
        if isLeft then handDragL = Vector3.zero else handDragR = Vector3.zero end
    end
    cont.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then rel() end end)
end
