-- // 2. СОЗДАНИЕ ГЛАДКИХ РУК
local function createSmoothPart(size, color, material)
    local part = Instance.new("Part")
    part.Size = size
    part.Color = color
    part.Material = material or Enum.Material.SmoothPlastic
    part.TopSurface = Enum.SurfaceType.SmoothNoOutlines
    part.BottomSurface = Enum.SurfaceType.SmoothNoOutlines
    part.LeftSurface = Enum.SurfaceType.SmoothNoOutlines
    part.RightSurface = Enum.SurfaceType.SmoothNoOutlines
    part.FrontSurface = Enum.SurfaceType.SmoothNoOutlines
    part.BackSurface = Enum.SurfaceType.SmoothNoOutlines
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Anchored = true
    part.CastShadow = false
    return part
end

local function buildDetailedArm(isLeft)
    local char = player.Character
    if not char then return nil end

    local model = Instance.new("Model")
    model.Name = isLeft and "SmoothArmL" or "SmoothArmR"

    local mainColor, cuffColor, armMat
    if HAND_STYLE == 1 then
        local refPart = char:FindFirstChild(isLeft and "LeftHand" or "RightHand") 
            or char:FindFirstChild(isLeft and "Left Arm" or "Right Arm") 
            or char:FindFirstChild("Head")
        mainColor = refPart and refPart.Color or Color3.fromRGB(225, 185, 145)
        cuffColor = Color3.fromRGB(0, 255, 180)
        armMat = Enum.Material.SmoothPlastic
    elseif HAND_STYLE == 2 then
        mainColor = Color3.fromRGB(20, 22, 28)
        cuffColor = Color3.fromRGB(0, 230, 255)
        armMat = Enum.Material.Neon
    else
        mainColor = Color3.fromRGB(35, 35, 40)
        cuffColor = Color3.fromRGB(255, 60, 60)
        armMat = Enum.Material.SmoothPlastic
    end

    local forearm = createSmoothPart(Vector3.new(0.48, 0.48, 1.1), mainColor, armMat)
    forearm.Name = "Forearm"
    forearm.Parent = model

    local cuff = createSmoothPart(Vector3.new(0.52, 0.52, 0.1), cuffColor, Enum.Material.Neon)
    cuff.Name = "Cuff"
    cuff.Parent = model

    local palm = createSmoothPart(Vector3.new(0.44, 0.35, 0.5), mainColor, armMat)
    palm.Name = "Palm"
    palm.Parent = model

    local fingers = createSmoothPart(Vector3.new(0.42, 0.28, 0.3), mainColor, armMat)
    fingers.Name = "Fingers"
    fingers.Parent = model

    model.Parent = viewmodelFolder
    return model
end

local function setupHands()
    if viewmodelFolder then viewmodelFolder:Destroy() end
    viewmodelFolder = Instance.new("Folder")
    viewmodelFolder.Name = "VR_Smooth_Hands"
    viewmodelFolder.Parent = camera

    leftArmModel = buildDetailedArm(true)
    rightArmModel = buildDetailedArm(false)
end

-- // 3. ТОТАЛЬНОЕ СКРЫТИЕ ВСЕХ ЧАСТЕЙ ТЕЛА И ДУБЛИКАТОВ
local function hideRealBodyAndEquippedTools()
    local char = player.Character
    if not char then return end

    -- Принудительно скрываем ВСЕ части персонажа и тулов локально
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("BasePart") then
            item.LocalTransparencyModifier = 1
        end
    end
end

-- // 4. ПРАВИЛЬНЫЙ ХВАТ 3D-ПРЕДМЕТОВ (БЕЗ УПАВШЕГО ОРУЖИЯ И БЕЗ КОПИЙ)
local function setupToolVisuals(tool)
    if toolVisualFolder then toolVisualFolder:Destroy() end
    toolVisualFolder = Instance.new("Folder")
    toolVisualFolder.Name = "VR_Tool_3D_Visuals"
    toolVisualFolder.Parent = viewmodelFolder

    toolPartOffsets = {}
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true)
    if not handle then return end

    for _, item in ipairs(tool:GetDescendants()) do
        if item:IsA("BasePart") then
            local clone = item:Clone()
            clone:ClearAllChildren()

            for _, sub in ipairs(item:GetChildren()) do
                if sub:IsA("SpecialMesh") or sub:IsA("Decal") or sub:IsA("Texture") or sub:IsA("SurfaceAppearance") then
                    sub:Clone().Parent = clone
                end
            end

            clone.CanCollide = false
            clone.CanTouch = false
            clone.CanQuery = false
            clone.Anchored = true
            clone.CastShadow = false
            clone.Transparency = item.Transparency
            clone.Parent = toolVisualFolder

            local relOffset = handle.CFrame:ToObjectSpace(item.CFrame)
            table.insert(toolPartOffsets, {Part = clone, Offset = relOffset, OrigPart = item})
        end
    end
end

local function updateHeldTool()
    local char = player.Character
    if not char then return end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        if currentToolRef ~= currentTool then
            currentToolRef = currentTool
            setupToolVisuals(currentTool)
        end

        local palm = rightArmModel and rightArmModel:FindFirstChild("Palm")
        local handle = currentTool:FindFirstChild("Handle") or currentTool:FindFirstChildWhichIsA("BasePart", true)
        
        if palm and handle and toolVisualFolder then
            local gripCF = currentTool.Grip
            local targetHandleCF

            -- ИСПРАВЛЕННЫЙ ХВАТ: Оружие стоит ровно вперед/вверх, а не падает
            if gripCF ~= CFrame.identity then
                targetHandleCF = palm.CFrame * CFrame.new(0, 0.1, -0.25) * gripCF:Inverse()
            else
                targetHandleCF = palm.CFrame * CFrame.new(0, 0.1, -0.35) * CFrame.Angles(0, 0, 0)
            end

            for _, data in ipairs(toolPartOffsets) do
                if data.Part and data.Part.Parent then
                    data.Part.CFrame = targetHandleCF * data.Offset
                end
            end
        end
    else
        if currentToolRef then
            currentToolRef = nil
            if toolVisualFolder then
                toolVisualFolder:Destroy()
                toolVisualFolder = nil
            end
            toolPartOffsets = {}
        end
    end
end

-- // 5. УПРАВЛЕНИЕ КАМЕРОЙ И ТАПАМИ
UserInputService.InputBegan:Connect(function(input, processed)
    if not VR_ACTIVE then return end
    
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local posX = input.Position.X
        local screenW = camera.ViewportSize.X

        if posX > screenW * 0.42 and not processed then
            cameraTouchInput = input
        end

        local ray = camera:ViewportPointToRay(input.Position.X, input.Position.Y)
        local localDir = camera.CFrame:VectorToObjectSpace(ray.Direction).Unit

        if posX < screenW * 0.5 then
            tapReachL = localDir * 1.35
            tapAlphaL = 1.0
        else
            tapReachR = localDir * 1.35
            tapAlphaR = 1.0
        end
    end
end)

UserInputService.InputChanged:Connect(function(input, processed)
    if not VR_ACTIVE then return end
    if input == cameraTouchInput then
        local delta = input.Delta
        if delta.Magnitude > 0 then
            local sens = 0.004 * SENS_MULTIPLIER
            touchYaw = touchYaw - delta.X * sens
            touchPitch = math.clamp(touchPitch - delta.Y * sens, math.rad(-75), math.rad(75))
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == cameraTouchInput then
        cameraTouchInput = nil
    end
end)

if UserInputService.GyroscopeEnabled then
    gyroConnection = UserInputService.DeviceRotationChanged:Connect(function(_, rotCFrame)
        rawGyroCF = rotCFrame
    end)
end

-- // 6. ГЛАВНЫЙ ЦИКЛ VR
local function startVR()
    VR_ACTIVE = true
    camera.CameraType = Enum.CameraType.Scriptable
    handPadL.Visible = true
    handPadR.Visible = true

    baseGyroCF = rawGyroCF
    smoothedCamRot = CFrame.identity
    lastCamCF = camera.CFrame
    touchYaw = 0
    touchPitch = 0

    camera.FieldOfView = FOV_MODES[FOV_INDEX]
    setupHands()

    toggleBtn.Text = "⏻ ВЫКЛЮЧИТЬ VR"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
    cardStroke.Color = Color3.fromRGB(255, 80, 80)

    -- Сетевой поворот тела (FE)
    physicsLoopConnection = RunService.Stepped:Connect(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if root and humanoid then
            humanoid.AutoRotate = false
            local look = camera.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude > 0.05 then
                local targetBodyCF = CFrame.lookAt(root.Position, root.Position + flatLook.Unit)
                root.CFrame = root.CFrame:Lerp(targetBodyCF, 0.3)
            end
        end
    end)

    -- Рендер
    mainLoopConnection = RunService.RenderStepped:Connect(function(dt)
        local char = player.Character
        if not char then return end

        -- Полное скрытие тела персонажа
        hideRealBodyAndEquippedTools()

        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not head or not root then return end

        -- 1. Камера
        local targetRot
        if CONTROL_MODE == "GYRO" then
            local deltaCF = baseGyroCF:ToObjectSpace(rawGyroCF)
            local rx, ry, rz = deltaCF:ToEulerAnglesYXZ()
            local gyroPitch = math.clamp(-rx, math.rad(-75), math.rad(75))
            local gyroYaw = -rz
            targetRot = CFrame.Angles(0, gyroYaw + touchYaw, 0) * CFrame.Angles(gyroPitch + touchPitch, 0, 0)
        else
            targetRot = CFrame.Angles(0, touchYaw, 0) * CFrame.Angles(touchPitch, 0, 0)
        end

        smoothedCamRot = smoothedCamRot:Lerp(targetRot, 0.4)

        local crouchOffset = IS_CROUCHING and -1.4 or 0
        local eyePos = head.Position + Vector3.new(0, 0.25 + crouchOffset, 0)
        camera.CFrame = CFrame.new(eyePos) * smoothedCamRot
        local camCF = camera.CFrame

        -- 2. Инерция рук
        local deltaRot = camCF:ToObjectSpace(lastCamCF)
        local swayTarget = CFrame.Angles(
            math.clamp(deltaRot.X * 0.5, -0.12, 0.12),
            math.clamp(deltaRot.Y * 0.5, -0.12, 0.12),
            0
        )
        swayCF = swayCF:Lerp(swayTarget, 0.25)
        lastCamCF = camCF

        -- 3. Шаги
        local speed = root.AssemblyLinearVelocity.Magnitude
        bobStep = bobStep + dt * (speed > 1 and 8 or 2.5)
        local bobX = math.sin(bobStep) * 0.02
        local bobY = math.cos(bobStep * 2) * 0.015

        -- 4. Затухание нажатий
        tapAlphaL = math.clamp(tapAlphaL - dt * 4, 0, 1)
        tapAlphaR = math.clamp(tapAlphaR - dt * 4, 0, 1)

        -- 5. Позиции рук
        currentHandOffsetL = currentHandOffsetL:Lerp(handDragL + (tapReachL * tapAlphaL), 0.28)
        currentHandOffsetR = currentHandOffsetR:Lerp(handDragR + (tapReachR * tapAlphaR), 0.28)

        local function updateArmModel(arm, isLeft, handOffset)
            if not arm then return end
            local side = isLeft and -1 or 1
            local reachForward = handOffset.Z
            
            local pitchTurn = math.rad(12 - reachForward * 22 + handOffset.Y * 18)
            local yawTurn = math.rad(-side * 8 + handOffset.X * 24)

            local base = camCF * swayCF 
                * CFrame.new(
                    side * (0.65 - (side * bobX)) + handOffset.X, 
                    -0.65 + bobY + handOffset.Y, 
                    -1.05 + reachForward
                )
                * CFrame.Angles(pitchTurn, yawTurn, math.rad(side * 4))

            local f = arm:FindFirstChild("Forearm")
            local c = arm:FindFirstChild("Cuff")
            local p = arm:FindFirstChild("Palm")
            local fg = arm:FindFirstChild("Fingers")

            if f and c and p and fg then
                f.CFrame = base * CFrame.new(0, 0, 0.35)
                c.CFrame = base * CFrame.new(0, 0, -0.22)
                p.CFrame = base * CFrame.new(0, -0.02, -0.5) * CFrame.Angles(math.rad(8), 0, 0)
                fg.CFrame = base * CFrame.new(0, -0.05, -0.85) * CFrame.Angles(math.rad(18), 0, 0)
            end
        end

        updateArmModel(leftArmModel, true, currentHandOffsetL)
        updateArmModel(rightArmModel, false, currentHandOffsetR)

        -- 6. Обновление 3D мешей оружия в руке
        updateHeldTool()
    end)
end

local function stopVR()
    VR_ACTIVE = false
    handPadL.Visible = false
    handPadR.Visible = false

    if mainLoopConnection then mainLoopConnection:Disconnect() mainLoopConnection = nil end
    if physicsLoopConnection then physicsLoopConnection:Disconnect() physicsLoopConnection = nil end

    camera.CameraType = Enum.CameraType.Custom
    camera.FieldOfView = 70

    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.AutoRotate = true end

        for _, item in ipairs(char:GetDescendants()) do
            if item:IsA("BasePart") then
                item.LocalTransparencyModifier = 0
            end
        end
    end

    if viewmodelFolder then viewmodelFolder:Destroy() viewmodelFolder = nil end
    currentToolRef = nil
    toolVisualFolder = nil
    toolPartOffsets = {}

    toggleBtn.Text = "⏻ ВКЛЮЧИТЬ VR"
    toggleBtn.TextColor3 = Color3.fromRGB(0, 255, 180)
    cardStroke.Color = Color3.fromRGB(0, 255, 180)
end

