-- // ДЖОЙСТИКИ РУК
local function makeLargeHandPad(isLeft)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 110, 0, 110)
    container.Position = isLeft and UDim2.new(0, 10, 0.38, 0) or UDim2.new(1, -120, 0.38, 0)
    container.BackgroundTransparency = 1
    container.Active = true
    container.Visible = false
    container.Parent = screenGui

    local pad = Instance.new("Frame")
    pad.Size = UDim2.new(0, 76, 0, 76)
    pad.Position = UDim2.new(0.5, -38, 0.5, -38)
    pad.BackgroundColor3 = Color3.fromRGB(14, 16, 24)
    pad.BackgroundTransparency = 0.2
    pad.Parent = container

    Instance.new("UICorner", pad).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke", pad)
    stroke.Thickness = 1.8
    stroke.Color = Color3.fromRGB(0, 255, 180)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 32, 0, 32)
    knob.Position = UDim2.new(0.5, -16, 0.5, -16)
    knob.BackgroundColor3 = Color3.fromRGB(0, 255, 180)
    knob.Parent = pad
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = isLeft and "L" or "R"
    label.TextColor3 = Color3.fromRGB(10, 15, 20)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Parent = knob

    local isDragging = false
    local touchStartPos = nil

    container.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            touchStartPos = input.Position
            stroke.Color = Color3.fromRGB(0, 255, 255)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - touchStartPos
            local dist = math.clamp(delta.Magnitude, 0, 32)
            local dir = delta.Magnitude > 0 and delta.Unit or Vector2.zero
            local visualOffset = dir * dist

            knob.Position = UDim2.new(0.5, -16 + visualOffset.X, 0.5, -16 + visualOffset.Y)

            local dx = math.clamp(delta.X / 40, -0.75, 0.75)
            local dy = math.clamp(-delta.Y / 40, -0.75, 0.75)
            local dz = -math.clamp(delta.Magnitude / 28, 0, 1.3)

            if isLeft then
                handDragL = Vector3.new(dx, dy, dz)
            else
                handDragR = Vector3.new(dx, dy, dz)
            end
        end
    end)

    local function release()
        isDragging = false
        touchStartPos = nil
        stroke.Color = Color3.fromRGB(0, 255, 180)
        TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0.5, -16, 0.5, -16)}):Play()
        if isLeft then handDragL = Vector3.zero else handDragR = Vector3.zero end
    end

    container.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            release()
        end
    end)

    return container
end

local handPadL = makeLargeHandPad(true)
