        calibBtn.Text = "🎯 ЦЕНТР"
    end
end)

minBtn.MouseButton1Click:Connect(function()
    MINIMIZED = not MINIMIZED
    if MINIMIZED then
        mainCard:TweenSize(UDim2.new(0, 36, 0, 36), "Out", "Quad", 0.2, true)
        for _, ch in ipairs(mainCard:GetChildren()) do
            if ch:IsA("GuiObject") and ch ~= minBtn and ch ~= cardStroke then
                ch.Visible = false
            end
        end
        minBtn.Text = "VR"
        minBtn.Position = UDim2.new(0, 7, 0, 7)
    else
        mainCard:TweenSize(UDim2.new(0, 215, 0, 200), "Out", "Quad", 0.2, true)
        task.wait(0.15)
        for _, ch in ipairs(mainCard:GetChildren()) do
            if ch:IsA("GuiObject") and ch ~= minBtn and ch ~= cardStroke then
                ch.Visible = true
            end
        end
        minBtn.Text = "—"
        minBtn.Position = UDim2.new(1, -54, 0, 6)
    end
end)

closeBtn.MouseButton1Click:Connect(function()
