-- // ПРОВЕРКА СТЕНЫ ДЛЯ КАРАБКАНИЯ (СТАБИЛЬНЫЙ ЛУЧ)
local function findClimbWallTarget(palmPart)
    if not palmPart then return nil, nil end
    local pPos = palmPart.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {player.Character, viewmodelFolder}

    local dirs = {
        camera.CFrame.LookVector * 3.5,
        palmPart.CFrame.LookVector * 3.0,
        (camera.CFrame.LookVector + palmPart.CFrame.LookVector).Unit * 3.0
    }

    for _, dir in ipairs(dirs) do
        local res = workspace:Raycast(pPos, dir, rayParams)
        if res and res.Instance and res.Instance:IsA("BasePart") and res.Instance.CanCollide and res.Instance.Anchored then
            return res.Position, res.Normal
        end
    end
    return nil, nil
end

-- // ПОИСК ПРЕДМЕТОВ ДЛЯ ХВАТА
local function findUniversalGrabTarget(palmPart, maxDist)
    if not palmPart then return nil end
    local pPos = palmPart.Position
    local closestObj = nil
    local closestDist = maxDist or 8.0

    for _, otherPlr in ipairs(Players:GetPlayers()) do
        if otherPlr ~= player and otherPlr.Character and otherPlr.Character:FindFirstChild("HumanoidRootPart") then
            local rPart = otherPlr.Character.HumanoidRootPart
            local d = (rPart.Position - pPos).Magnitude
            if d < closestDist then
                closestDist = d
                closestObj = {Type = "PLAYER", Target = otherPlr, Part = rPart, Name = otherPlr.Name}
            end
        end
    end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.FilterDescendantsInstances = {player.Character, viewmodelFolder}

    local nearbyParts = workspace:GetPartBoundsInRadius(pPos, closestDist, overlapParams)
    for _, p in ipairs(nearbyParts) do
        if p:IsA("BasePart") and p.Transparency < 0.95 and p.Size.Magnitude < 45 and not p.Anchored then
            local d = (p.Position - pPos).Magnitude
            if d < closestDist then
                closestDist = d
                local modelParent = p:FindFirstAncestorOfClass("Model")
                if modelParent and modelParent.PrimaryPart and modelParent ~= workspace then
                    closestObj = {Type = "MODEL", Target = modelParent, Part = modelParent.PrimaryPart, Name = modelParent.Name}
                else
                    closestObj = {Type = "PART", Target = p, Part = p, Name = p.Name}
                end
            end
        end
    end

    return closestObj
end

