local function startNetworkSync()
    pcall(function()
        local wsFunc = (WebSocket and WebSocket.connect) or (syn and syn.websocket and syn.websocket.connect)
        if wsFunc then
            -- Используем открытый кластер PieSocket для мгновенной пересылки сырых JSON-пакетов
            wsConnection = wsFunc("wss://free.blr2.piesocket.com/v3/1?api_key=vcXCEuvhGcBDP7XhiJJILwyBgRQcsyNR113N4i9K")
        end

        if wsConnection then
            netStatusLbl.Text = "🟢 VR СЕТЬ: Подключено"
            netStatusLbl.TextColor3 = Color3.fromRGB(0, 255, 180)

            wsConnection.OnMessage:Connect(function(msg)
                pcall(function()
                    local data = HttpService:JSONDecode(msg)
                    -- Проверяем, что сообщение от этого скрипта и с этого же сервера Roblox
                    if data and data.sys == "VR_V24" and data.userId ~= player.UserId and data.jobId == game.JobId then
                        local remotePlr = Players:GetPlayerByUserId(data.userId)
                        if remotePlr and remotePlr.Character then
                            if not remoteVRUsers[data.userId] then
                                local rFolder = Instance.new("Folder", workspace)
                                rFolder.Name = "RemoteVR_" .. data.userId
                                remoteVRUsers[data.userId] = {
                                    Folder = rFolder,
                                    Left = buildArm(true, rFolder),
                                    Right = buildArm(false, rFolder),
                                    LastTick = tick()
                                }
                            end

                            local userObj = remoteVRUsers[data.userId]
                            userObj.LastTick = tick()

                            local lCF = CFrame.new(unpack(data.lPos)) * CFrame.Angles(unpack(data.lRot))
                            local rCF = CFrame.new(unpack(data.rPos)) * CFrame.Angles(unpack(data.rRot))

                            local function applyRemote(arm, baseCF)
                                local f, c, p, fg = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("Palm"), arm:FindFirstChild("Fingers")
                                if f and c and p and fg then
                                    f.CFrame = baseCF * CFrame.new(0, 0, 0.35)
                                    c.CFrame = baseCF * CFrame.new(0, 0, -0.22)
                                    p.CFrame = baseCF * CFrame.new(0, -0.02, -0.5) * CFrame.Angles(math.rad(8), 0, 0)
                                    fg.CFrame = baseCF * CFrame.new(0, -0.05, -0.85) * CFrame.Angles(math.rad(18), 0, 0)
                                end
                            end
                            applyRemote(userObj.Left, lCF)
                            applyRemote(userObj.Right, rCF)
                        end
                    end
                end)
            end)
        else
            netStatusLbl.Text = "🟡 VR СЕТЬ: Офлайн (Локально)"
            netStatusLbl.TextColor3 = Color3.fromRGB(255, 200, 100)
        end
    end)
end

-- // 5. ИНТЕРАКТИВ КАМЕРЫ
UserInputService.InputBegan:Connect(function(input, processed)
    if not VR_ACTIVE then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local posX = input.Position.X
        if posX > camera.ViewportSize.X * 0.42 and not processed and not EDITING_UI then cameraTouchInput = input end
        if not processed and not EDITING_UI then
            local ray = camera:ViewportPointToRay(input.Position.X, input.Position.Y)
            local localDir = camera.CFrame:VectorToObjectSpace(ray.Direction).Unit
            local aimRot = CFrame.lookAt(Vector3.zero, localDir)
            if posX < camera.ViewportSize.X * 0.5 then tapReachL, tapRotL, tapAlphaL = localDir * 1.4, aimRot, 1
            else tapReachR, tapRotR, tapAlphaR = localDir * 1.4, aimRot, 1 end
        end
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if VR_ACTIVE and input == cameraTouchInput then
        local delta = input.Delta
        if delta.Magnitude > 0 then
            touchYaw = touchYaw - delta.X * (0.004 * SENS_MULTIPLIER)
            touchPitch = math.clamp(touchPitch - delta.Y * (0.004 * SENS_MULTIPLIER), math.rad(-75), math.rad(75))
        end
    end
end)
UserInputService.InputEnded:Connect(function(input) if input == cameraTouchInput then cameraTouchInput = nil end end)
if UserInputService.GyroscopeEnabled then gyroConnection = UserInputService.DeviceRotationChanged:Connect(function(_, rotCFrame) rawGyroCF = rotCFrame end) end

