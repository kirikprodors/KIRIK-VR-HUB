local function getWebSocketFunc()
    if syn and type(syn.websocket) == "table" and type(syn.websocket.connect) == "function" then
        return syn.websocket.connect
    elseif WebSocket and type(WebSocket.connect) == "function" then
        return WebSocket.connect
    elseif websocket and type(websocket.connect) == "function" then
        return websocket.connect
    elseif Krnl and Krnl.WebSocket and type(Krnl.WebSocket.connect) == "function" then
        return Krnl.WebSocket.connect
    end
    return nil
end

local function cleanupNet()
    if heartbeatThread then task.cancel(heartbeatThread) heartbeatThread = nil end
    if wsConnection then pcall(function() wsConnection:Close() end) wsConnection = nil end
    for _, u in pairs(remoteVRUsers) do 
        if u.Folder then u.Folder:Destroy() end 
    end
    remoteVRUsers = {}
    isConnectingNet = false
    beingGrabbedBy = nil
end

local function updateNetCountLabel()
    if not VR_ACTIVE or not NETWORK_ENABLED then return end
    local count = 1
    for _ in pairs(remoteVRUsers) do count = count + 1 end
    netStatus.Text = "🟢 VR СЕТЬ: Онлайн (Игроков: " .. count .. ")"
    netStatus.TextColor3 = Color3.fromRGB(0, 255, 180)
end

local function startNetworkSync()
    cleanupNet()
    if not NETWORK_ENABLED or not VR_ACTIVE then
        netStatus.Text = "🟢 VR: Активен | ⚪ Сеть выключена"
        netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
        return
    end

    netAttemptId = netAttemptId + 1
    local thisAttempt = netAttemptId
    isConnectingNet = true

    task.spawn(function()
        pcall(function()
            local wsConnect = getWebSocketFunc()
            if not wsConnect then
                netStatus.Text = "🟢 VR: Активен | ⚪ Одиночный (Без WS)"
                netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
                isConnectingNet = false
                return
            end

            netStatus.Text = "🟢 VR: Активен | 🟡 Подключение..."
            netStatus.TextColor3 = Color3.fromRGB(255, 215, 0)

            local ok, ws = pcall(function() return wsConnect(MY_PRIVATE_WS_URL) end)
            if ok and ws and thisAttempt == netAttemptId and VR_ACTIVE and NETWORK_ENABLED then
                wsConnection = ws
                updateNetCountLabel()

                pcall(function()
                    wsConnection:Send(HttpService:JSONEncode({s = "VR50_HELLO", u = player.UserId, un = player.Name}))
                end)

                heartbeatThread = task.spawn(function()
                    while wsConnection and VR_ACTIVE and NETWORK_ENABLED do
                        task.wait(10)
                        pcall(function() wsConnection:Send(HttpService:JSONEncode({s = "PING", u = player.UserId})) end)
                    end
                end)

                wsConnection.OnMessage:Connect(function(msg)
                    pcall(function()
                        local data = HttpService:JSONDecode(msg)
                        if type(data) ~= "table" or data.u == player.UserId then return end

                        if data.s == "VR50" or data.s == "VR49" or data.s == "VR47" then
                            local remotePlr = Players:GetPlayerByUserId(data.u) or (data.un and Players:FindFirstChild(data.un))
                            
                            if not remoteVRUsers[data.u] then
                                local rFolder = Instance.new("Folder", workspace)
                                rFolder.Name = "RemoteVR_" .. data.u
                                remoteVRUsers[data.u] = {
                                    Folder = rFolder,
                                    Left = buildArm(true, rFolder, data.st, remotePlr),
                                    Right = buildArm(false, rFolder, data.st, remotePlr),
                                    Visor = buildVisor(rFolder, data.st, remotePlr),
                                    Style = data.st,
                                    TargetL = CFrame.identity,
                                    TargetR = CFrame.identity,
                                    TargetHead = CFrame.identity,
                                    CurrentL = CFrame.identity,
                                    CurrentR = CFrame.identity,
                                    CurrentHead = CFrame.identity,
                                    GrabL = false,
                                    GrabR = false,
                                    ClimbL = false,
                                    ClimbR = false,
                                    AnchorL = nil,
                                    AnchorR = nil,
                                    HeldObjL = nil,
                                    HeldObjR = nil,
                                    LastTick = tick()
                                }
                                updateNetCountLabel()
                            end

                            local u = remoteVRUsers[data.u]
                            u.LastTick = tick()
                            u.GrabL = data.gL or false
                            u.GrabR = data.gR or false
                            u.ClimbL = data.cL or false
                            u.ClimbR = data.cR or false
                            u.AnchorL = data.aL and Vector3.new(unpack(data.aL)) or nil
                            u.AnchorR = data.aR and Vector3.new(unpack(data.aR)) or nil
                            u.HeldObjL = data.objL
                            u.HeldObjR = data.objR

                            if u.Style ~= data.st then
                                u.Style = data.st
                                applyStyleToModel(u.Left, data.st, remotePlr)
                                applyStyleToModel(u.Right, data.st, remotePlr)
                                applyStyleToModel(u.Visor, data.st, remotePlr)
                            end

                            local hasRoot = remotePlr and remotePlr.Character and remotePlr.Character:FindFirstChild("HumanoidRootPart")
                            if hasRoot and data.lp and data.lr and data.rp and data.rr then
                                local remoteRoot = remotePlr.Character.HumanoidRootPart
                                local shoulderL = remoteRoot.CFrame * CFrame.new(-1.1, -0.15, -0.2)
                                local shoulderR = remoteRoot.CFrame * CFrame.new(1.1, -0.15, -0.2)

                                u.TargetL = shoulderL * (CFrame.new(unpack(data.lp)) * CFrame.Angles(unpack(data.lr)))
                                u.TargetR = shoulderR * (CFrame.new(unpack(data.rp)) * CFrame.Angles(unpack(data.rr)))
                            elseif data.wlp and data.wlr and data.wrp and data.wrr then
                                u.TargetL = CFrame.new(unpack(data.wlp)) * CFrame.Angles(unpack(data.wlr))
                                u.TargetR = CFrame.new(unpack(data.wrp)) * CFrame.Angles(unpack(data.wrr))
                            end

                            if data.hp and data.hr then
                                u.TargetHead = CFrame.new(unpack(data.hp)) * CFrame.Angles(unpack(data.hr))
                            end

                            if remotePlr and remotePlr.Character then
                                local c = remotePlr.Character
                                for _, limbName in ipairs({"Left Arm", "Right Arm", "LeftHand", "LeftLowerArm", "LeftUpperArm", "RightHand", "RightLowerArm", "RightUpperArm"}) do
                                    local limb = c:FindFirstChild(limbName)
                                    if limb and limb:IsA("BasePart") then limb.Transparency = 1 end
                                end
                            end

                            if data.gb and data.gb.target == player.UserId then
                                beingGrabbedBy = {Grabber = data.u, Hand = data.gb.hand, Dist = data.gb.dist or 4.0}
                            elseif beingGrabbedBy and beingGrabbedBy.Grabber == data.u then
                                beingGrabbedBy = nil
                            end
                        end
                    end)
                end)

                wsConnection.OnClose:Connect(function()
                    cleanupNet()
                    if VR_ACTIVE and NETWORK_ENABLED then
                        netStatus.Text = "🟢 VR: Активен | ⚪ Одиночный режим"
                        netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
                    end
                end)
            else
                cleanupNet()
                if VR_ACTIVE then
                    netStatus.Text = "🟢 VR: Активен | ⚪ Одиночный режим"
                    netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)
                end
            end
            isConnectingNet = false
        end)
    end)
end

-- // 7. ВВОД КАМЕРЫ И СЕНСОРНОГО КАРАБКАНИЯ
UserInputService.InputBegan:Connect(function(input, processed)
    if not VR_ACTIVE or EDITING_UI or processed then return end

    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local vpSize = camera.ViewportSize
        local isUpperHalf = input.Position.Y < (vpSize.Y * 0.48)
        local isLeftSide = input.Position.X < (vpSize.X * 0.5)

        if HAND_INPUT_MODE == "SCREEN_DRAG" then
            if isUpperHalf then
                if not camTouchInput then
                    camTouchInput = input
                    camTouchLastPos = Vector2.new(input.Position.X, input.Position.Y)
                end
            else
                if isLeftSide and not screenTouchL then
                    screenTouchL = input
                    screenTouchLStart = input.Position
                    if CLIMB_ENABLED then
                        local palm = leftArmModel and leftArmModel:FindFirstChild("Palm")
                        local wPos, wNorm = findClimbWallTarget(palm)
                        if wPos then
                            isClimbingL = true
                            climbAnchorPosL = wPos
                            wallNormalL = wNorm
                        end
                    end
                elseif not isLeftSide and not screenTouchR then
                    screenTouchR = input
                    screenTouchRStart = input.Position
                    if CLIMB_ENABLED then
                        local palm = rightArmModel and rightArmModel:FindFirstChild("Palm")
                        local wPos, wNorm = findClimbWallTarget(palm)
                        if wPos then
                            isClimbingR = true
                            climbAnchorPosR = wPos
                            wallNormalR = wNorm
                        end
                    end
                end
            end
        else
            if input.Position.X > (vpSize.X * 0.30) and not camTouchInput then
                camTouchInput = input
                camTouchLastPos = Vector2.new(input.Position.X, input.Position.Y)
            end

            local ray = camera:ViewportPointToRay(input.Position.X, input.Position.Y)
            local localDir = camera.CFrame:VectorToObjectSpace(ray.Direction).Unit
            local aimRot = CFrame.lookAt(Vector3.zero, localDir)
            if isLeftSide then
                tapReachL, tapRotL, tapAlphaL = localDir * 1.3, aimRot, 1
            else
                tapReachR, tapRotR, tapAlphaR = localDir * 1.3, aimRot, 1
            end
        end
    end
end)

UserInputService.InputChanged:Connect(function(input, processed)
    if not VR_ACTIVE or EDITING_UI then return end

    if input == camTouchInput and camTouchLastPos then
        local curPos = Vector2.new(input.Position.X, input.Position.Y)
        local d = curPos - camTouchLastPos
        camTouchLastPos = curPos

        touchYaw = touchYaw - d.X * (0.0035 * SENS_MULTIPLIER)
        touchPitch = math.clamp(touchPitch - d.Y * (0.0035 * SENS_MULTIPLIER), math.rad(-75), math.rad(75))
    end

    if HAND_INPUT_MODE == "SCREEN_DRAG" then
        if input == screenTouchL and screenTouchLStart then
            local delta = input.Position - screenTouchLStart
            handDragL = Vector3.new(
                math.clamp(delta.X / 55, -0.9, 0.9),
                math.clamp(-delta.Y / 55, -0.9, 0.9),
                -math.clamp(delta.Magnitude / 35, 0, 1.5)
            )
        elseif input == screenTouchR and screenTouchRStart then
            local delta = input.Position - screenTouchRStart
            handDragR = Vector3.new(
                math.clamp(delta.X / 55, -0.9, 0.9),
                math.clamp(-delta.Y / 55, -0.9, 0.9),
                -math.clamp(delta.Magnitude / 35, 0, 1.5)
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == camTouchInput then
        camTouchInput, camTouchLastPos = nil, nil
    end
    if input == screenTouchL then
        screenTouchL, screenTouchLStart = nil, nil
        handDragL = Vector3.zero
        isClimbingL = false
        climbAnchorPosL = nil
    end
    if input == screenTouchR then
        screenTouchR, screenTouchRStart = nil, nil
        handDragR = Vector3.zero
        isClimbingR = false
        climbAnchorPosR = nil
    end
end)

if UserInputService.GyroscopeEnabled then
    gyroConnection = UserInputService.DeviceRotationChanged:Connect(function(_, rotCFrame) rawGyroCF = rotCFrame end)
end

-- // 8. ГЛАВНЫЙ ЦИКЛ РЕНДЕРА И БЕЗУПРЕЧНАЯ ФИЗИКА КАРАБКАНИЯ
local function startVR()
    VR_ACTIVE = true
    camera.CameraType = Enum.CameraType.Scriptable

    for _, w in pairs(widgetRegistry) do
        w.Frame.Visible = true
    end
    refreshMovementJoysticksVisibility()

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local _, rYaw, _ = root.CFrame:ToEulerAnglesYXZ()
        touchYaw = rYaw
    else
        touchYaw = 0
    end
    touchPitch = 0

    baseGyroCF, smoothedCamRot, lastCamCF = rawGyroCF, CFrame.Angles(0, touchYaw, 0), camera.CFrame
    camera.FieldOfView = FOV_MODES[FOV_INDEX]
    
    setupHands()
    startNetworkSync()

    toggleBtn.Text, toggleBtn.TextColor3 = "⏻ ВЫКЛЮЧИТЬ VR", Color3.fromRGB(255, 80, 80)
    cardStroke.Color = Color3.fromRGB(255, 80, 80)

    -- Поворот тела
    physicsLoopConnection = RunService.Stepped:Connect(function()
        pcall(function()
            local curChar = player.Character
            local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
            local humanoid = curChar and curChar:FindFirstChildOfClass("Humanoid")
            if not curChar or not curRoot or not humanoid then return end

            humanoid.AutoRotate = false

            if isClimbingL or isClimbingR then
                -- Поворот лицом к стене без дерганья
                local avgWallNormal = ((isClimbingL and wallNormalL or Vector3.zero) + (isClimbingR and wallNormalR or Vector3.zero)).Unit
                if avgWallNormal.Magnitude > 0.1 then
                    local lookDir = -Vector3.new(avgWallNormal.X, 0, avgWallNormal.Z).Unit
                    curRoot.CFrame = CFrame.lookAt(curRoot.Position, curRoot.Position + lookDir)
                end
            else
                local look = camera.CFrame.LookVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                if flatLook.Magnitude > 0.05 then
                    local targetRot = CFrame.lookAt(Vector3.zero, flatLook.Unit)
                    curRoot.CFrame = CFrame.new(curRoot.Position) * targetRot
                end
            end
        end)
    end)

    mainLoopConnection = RunService.RenderStepped:Connect(function(dt)
        pcall(function()
            local curChar = player.Character
            if not curChar then return end

            local curRoot = curChar:FindFirstChild("HumanoidRootPart")
            local humanoid = curChar and curChar:FindFirstChildOfClass("Humanoid")
            local head = curChar:FindFirstChild("Head")
            if not head or not curRoot or not humanoid then return end

            -- Скрытие тела
            local currentTool = curChar:FindFirstChildOfClass("Tool")
            for _, item in ipairs(curChar:GetDescendants()) do
                if item:IsA("BasePart") or item:IsA("Decal") then
                    if currentTool and item:IsDescendantOf(currentTool) then
                        item.LocalTransparencyModifier = 0
                    else
                        item.LocalTransparencyModifier = 1
                    end
                end
            end

            -- Ходьба
            if not EDITING_UI and not (isClimbingL or isClimbingR) then
                local moveZ = (moveForward and -1 or 0) + (moveBackward and 1 or 0)
                local moveX = (moveRight and 1 or 0) + (moveLeft and -1 or 0)
                if moveZ ~= 0 or moveX ~= 0 then
                    local _, camYaw, _ = camera.CFrame:ToEulerAnglesYXZ()
                    local moveDir = CFrame.Angles(0, camYaw, 0) * Vector3.new(moveX, 0, moveZ)
                    humanoid:Move(moveDir.Unit, false)
                else
                    humanoid:Move(Vector3.zero, false)
                end
            end

            -- // СТАБИЛЬНАЯ ФИЗИКА КАРАБКАНИЯ (БЕЗ ДЁРГАНИЙ И ПРОВАЛОВ В СТЕНУ)
            if CLIMB_ENABLED and (isClimbingL or isClimbingR) then
                curRoot.AssemblyLinearVelocity = Vector3.zero
                curRoot.AssemblyAngularVelocity = Vector3.zero

                local pullIntent = Vector3.zero
                local activeHands = 0

                if isClimbingL then
                    -- Тяга руки: ведение пальца вниз тянет тело вверх
                    local moveVec = Vector3.new(-handDragL.X, -handDragL.Y, handDragL.Z)
                    local worldPull = (camera.CFrame.RightVector * moveVec.X) + (Vector3.new(0, 1, 0) * moveVec.Y) + (camera.CFrame.LookVector * moveVec.Z)
                    pullIntent = pullIntent + worldPull
                    activeHands = activeHands + 1
                end

                if isClimbingR then
                    local moveVec = Vector3.new(-handDragR.X, -handDragR.Y, handDragR.Z)
                    local worldPull = (camera.CFrame.RightVector * moveVec.X) + (Vector3.new(0, 1, 0) * moveVec.Y) + (camera.CFrame.LookVector * moveVec.Z)
                    pullIntent = pullIntent + worldPull
                    activeHands = activeHands + 1
                end

                if activeHands > 0 then
                    local finalStep = (pullIntent / activeHands) * (15 * dt)
                    local targetPos = curRoot.Position + finalStep

                    -- Проверка столкновения со стеной (не дает провалиться)
                    local avgNorm = ((isClimbingL and wallNormalL or Vector3.zero) + (isClimbingR and wallNormalR or Vector3.zero)).Unit
                    local wallRayParams = RaycastParams.new()
                    wallRayParams.FilterType = Enum.RaycastFilterType.Exclude
                    wallRayParams.FilterDescendantsInstances = {curChar, viewmodelFolder}
                    
                    local wallCheck = workspace:Raycast(targetPos, -avgNorm * 3.5, wallRayParams)
                    if wallCheck then
                        local minWallDist = 1.85
                        local curDist = (wallCheck.Position - targetPos).Magnitude
                        if curDist < minWallDist then
                            targetPos = wallCheck.Position + (wallCheck.Normal * minWallDist)
                        end
                    end

                    curRoot.CFrame = CFrame.new(targetPos) * (curRoot.CFrame - curRoot.Position)
                end

                -- Автоматический срыв, если рука слишком далеко растянулась
                if isClimbingL and climbAnchorPosL and (curRoot.Position - climbAnchorPosL).Magnitude > 6.0 then
                    isClimbingL, climbAnchorPosL = false, nil
                end
                if isClimbingR and climbAnchorPosR and (curRoot.Position - climbAnchorPosR).Magnitude > 6.0 then
                    isClimbingR, climbAnchorPosR = false, nil
                end
            end

            -- Камера
            local targetRot
            if CONTROL_MODE == "GYRO" then
                local rx, ry, rz = baseGyroCF:ToObjectSpace(rawGyroCF):ToEulerAnglesYXZ()
                targetRot = CFrame.Angles(0, -rz + touchYaw, 0) * CFrame.Angles(math.clamp(-rx, math.rad(-75), math.rad(75)) + touchPitch, 0, 0)
            else
                targetRot = CFrame.Angles(0, touchYaw, 0) * CFrame.Angles(touchPitch, 0, 0)
            end

            smoothedCamRot = smoothedCamRot:Lerp(targetRot, 0.4)

            local isMoving = curRoot.AssemblyLinearVelocity.Magnitude > 1.5
            bobStep = bobStep + dt * (isMoving and 8.5 or 2.2)
            local bobX, bobY = math.sin(bobStep) * 0.018, math.cos(bobStep * 2) * 0.012

            local camWalkLift = (isMoving and not (isClimbingL or isClimbingR)) and (math.abs(math.sin(bobStep)) * 0.12) or 0
            local camTiltRoll = (isMoving and not (isClimbingL or isClimbingR)) and (math.sin(bobStep) * 0.014) or 0
            local headBaseHeight = IS_CROUCHING and -1.4 or 0.25

            camera.CFrame = CFrame.new(head.Position + Vector3.new(0, headBaseHeight + camWalkLift, 0)) 
                * smoothedCamRot 
                * CFrame.Angles(0, 0, camTiltRoll)
                
            local camCF = camera.CFrame

            -- Инерция
            local dRot = camCF:ToObjectSpace(lastCamCF)
            swayCF = swayCF:Lerp(CFrame.Angles(math.clamp(dRot.X * 0.4, -0.08, 0.08), math.clamp(dRot.Y * 0.4, -0.08, 0.08), 0), 0.25)
            lastCamCF = camCF

            tapAlphaL = math.clamp(tapAlphaL - dt * 4, 0, 1)
            tapAlphaR = math.clamp(tapAlphaR - dt * 4, 0, 1)

            currentHandOffsetL = currentHandOffsetL:Lerp(handDragL + (tapReachL * tapAlphaL), 0.28)
            currentHandOffsetR = currentHandOffsetR:Lerp(handDragR + (tapReachR * tapAlphaR), 0.28)

            local finalLeftCF, finalRightCF = nil, nil

            local function updateArm(arm, isL, off, tRot, tAlpha, wPitch, wYaw, wRoll, isGrabbing, isClimbing, wallAnchor)
                if not arm then return end
                local side = isL and -1 or 1
                local userWrist = CFrame.Angles(wPitch, wYaw, wRoll or 0)
                local baseAngle = CFrame.Angles(math.rad(-14 + off.Y * 18 - off.Z * 12), math.rad(-side * 8 + off.X * 16), math.rad(side * 6)) * userWrist
                local finalAngle = baseAngle:Lerp(tRot, tAlpha * 0.8)

                local base = camCF * swayCF * CFrame.new(side * (0.68 - (side * bobX)) + off.X, -0.85 + bobY + off.Y, -1.15 + off.Z) * finalAngle
                
                -- Визуальное прижатие руки к точке на стене
                if isClimbing and wallAnchor then
                    base = CFrame.new(wallAnchor) * (base - base.Position)
                end

                if isL then finalLeftCF = base else finalRightCF = base end

                local f, c, cr, p, ap, fg, sn, th, tt = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("CuffRing"), arm:FindFirstChild("Palm"), arm:FindFirstChild("ArmorPlate"), arm:FindFirstChild("Fingers"), arm:FindFirstChild("Sensors"), arm:FindFirstChild("Thumb"), arm:FindFirstChild("ThumbTip")
                if f and c and p and fg then
                    f.CFrame = base * CFrame.new(0, -0.02, 0.40)
                    c.CFrame = base * CFrame.new(0, -0.01, -0.08)
                    if cr then cr.CFrame = base * CFrame.new(0, -0.01, -0.16) end
                    p.CFrame = base * CFrame.new(0, 0, -0.32)
                    if ap then ap.CFrame = base * CFrame.new(0, 0.12, -0.32) end

                    if isGrabbing or isClimbing then
                        fg.CFrame = base * CFrame.new(0, -0.06, -0.48) * CFrame.Angles(math.rad(-65), 0, 0)
                        if sn then sn.CFrame = base * CFrame.new(0, 0.04, -0.50) end
                        if th then th.CFrame = base * CFrame.new(side * 0.16, -0.06, -0.28) * CFrame.Angles(math.rad(-30), math.rad(side * 40), 0) end
                    else
                        fg.CFrame = base * CFrame.new(0, -0.03, -0.62) * CFrame.Angles(math.rad(-10), 0, 0)
                        if sn then sn.CFrame = base * CFrame.new(0, 0.08, -0.64) end
                        if th then th.CFrame = base * CFrame.new(side * 0.22, -0.02, -0.30) * CFrame.Angles(0, math.rad(side * 28), math.rad(side * 10)) end
                    end
                    if tt and th then tt.CFrame = th.CFrame * CFrame.new(0, 0.08, -0.12) end
                end
            end

            updateArm(leftArmModel, true, currentHandOffsetL, tapRotL, tapAlphaL, wristPitchL, wristYawL, wristRollL, (grabbedDataL ~= nil or isClimbingL), isClimbingL, climbAnchorPosL)
            updateArm(rightArmModel, false, currentHandOffsetR, tapRotR, tapAlphaR, wristPitchR, wristYawR, wristRollR, (grabbedDataR ~= nil or isClimbingR), isClimbingR, climbAnchorPosR)

            -- Двуручный хват оружия
            if currentTool then
                local rightGrip = nil
                for _, v in ipairs(curChar:GetDescendants()) do 
                    if v:IsA("Weld") and (v.Name == "RightGrip" or v.Name == "ToolGrip") then 
                        rightGrip = v 
                        break 
                    end 
                end
                local vrPalmR = rightArmModel and rightArmModel:FindFirstChild("Palm")
                local vrPalmL = leftArmModel and leftArmModel:FindFirstChild("Palm")

                if rightGrip and vrPalmR then
                    rightGrip.Part0 = vrPalmR
                    if TWO_HAND_MODE and vrPalmL then
                        local diff = (vrPalmR.Position - vrPalmL.Position)
                        if diff.Magnitude > 0.25 then
                            local lookRotation = CFrame.lookAt(vrPalmR.Position, vrPalmR.Position + diff.Unit)
                            rightGrip.C0 = vrPalmR.CFrame:ToObjectSpace(lookRotation) * CFrame.Angles(math.rad(-90), 0, math.rad(90))
                        else
                            rightGrip.C0 = CFrame.new(0, -0.05, -0.15) * CFrame.Angles(math.rad(-90), 0, 0)
                        end
                    else
                        rightGrip.C0 = CFrame.new(0, -0.05, -0.15) * CFrame.Angles(math.rad(-90), 0, 0)
                    end
                    rightGrip.C1 = currentTool.Grip
                end
            end

            -- // УНИВЕРСАЛЬНЫЙ SANDBOX ХВАТ
            if OBJECT_GRAB_ENABLED then
                local vrPalmL = leftArmModel and leftArmModel:FindFirstChild("Palm")
                local vrPalmR = rightArmModel and rightArmModel:FindFirstChild("Palm")

                if grabbedDataL and grabbedDataR and grabbedDataL.Target == grabbedDataR.Target and vrPalmL and vrPalmR then
                    local targetObj = grabbedDataL
                    local pL, pR = vrPalmL.Position, vrPalmR.Position
                    local midPos = (pL + pR) * 0.5
                    local forwardDir = camera.CFrame.LookVector
                    local holdPos = midPos + (forwardDir * grabDistBoth)
                    local handRoll = math.atan2(pR.Y - pL.Y, math.max(0.1, (Vector2.new(pR.X, pR.Z) - Vector2.new(pL.X, pL.Z)).Magnitude))
                    local holdRot = CFrame.lookAt(holdPos, holdPos + forwardDir) * CFrame.Angles(wristPitchR, wristYawR, handRoll)
                    
                    if targetObj.Type == "PLAYER" then
                        targetObj.Part.CFrame = targetObj.Part.CFrame:Lerp(holdRot, 0.35)
                    elseif targetObj.Type == "MODEL" then
                        targetObj.Target:PivotTo(targetObj.Target:GetPivot():Lerp(holdRot, 0.35))
                    else
                        targetObj.Part.CFrame = targetObj.Part.CFrame:Lerp(holdRot, 0.35)
                    end
                    targetObj.Part.AssemblyLinearVelocity = Vector3.zero
                else
                    if grabbedDataL and vrPalmL and grabbedDataL.Part then
                        local holdCF = vrPalmL.CFrame * CFrame.new(0, 0, -grabDistL) * CFrame.Angles(wristPitchL, wristYawL, 0)
                        if grabbedDataL.Type == "PLAYER" then
                            grabbedDataL.Part.CFrame = grabbedDataL.Part.CFrame:Lerp(holdCF, 0.35)
                        elseif grabbedDataL.Type == "MODEL" then
                            grabbedDataL.Target:PivotTo(grabbedDataL.Target:GetPivot():Lerp(holdCF, 0.35))
                        else
                            grabbedDataL.Part.CFrame = grabbedDataL.Part.CFrame:Lerp(holdCF, 0.35)
                        end
                        grabbedDataL.Part.AssemblyLinearVelocity = Vector3.zero
                    end

                    if grabbedDataR and vrPalmR and grabbedDataR.Part then
                        local holdCF = vrPalmR.CFrame * CFrame.new(0, 0, -grabDistR) * CFrame.Angles(wristPitchR, wristYawR, 0)
                        if grabbedDataR.Type == "PLAYER" then
                            grabbedDataR.Part.CFrame = grabbedDataR.Part.CFrame:Lerp(holdCF, 0.35)
                        elseif grabbedDataR.Type == "MODEL" then
                            grabbedDataR.Target:PivotTo(grabbedDataR.Target:GetPivot():Lerp(holdCF, 0.35))
                        else
                            grabbedDataR.Part.CFrame = grabbedDataR.Part.CFrame:Lerp(holdCF, 0.35)
                        end
                        grabbedDataR.Part.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end

            -- Синхронизация, когда меня держат
            if beingGrabbedBy and remoteVRUsers[beingGrabbedBy.Grabber] then
                local grabberData = remoteVRUsers[beingGrabbedBy.Grabber]
                local grabCF = (beingGrabbedBy.Hand == "L") and grabberData.CurrentL or grabberData.CurrentR
                local d = beingGrabbedBy.Dist or 4.0
                if grabCF and curRoot then
                    curRoot.CFrame = curRoot.CFrame:Lerp(grabCF * CFrame.new(0, 0, -d), 0.35)
                    curRoot.AssemblyLinearVelocity = Vector3.zero
                end
            end

            -- // ОТПРАВКА В СЕТЬ
            if NETWORK_ENABLED and wsConnection and tick() - lastNetSend > 0.045 and finalLeftCF and finalRightCF then
                lastNetSend = tick()
                pcall(function()
                    local shoulderL = curRoot.CFrame * CFrame.new(-1.1, -0.15, -0.2)
                    local shoulderR = curRoot.CFrame * CFrame.new(1.1, -0.15, -0.2)

                    local relL = shoulderL:ToObjectSpace(finalLeftCF)
                    local relR = shoulderR:ToObjectSpace(finalRightCF)

                    local grabPacket = nil
                    if grabbedDataL and grabbedDataL.Type == "PLAYER" and grabbedDataR and grabbedDataR.Type == "PLAYER" and grabbedDataL.Target == grabbedDataR.Target then
                        grabPacket = {target = grabbedDataL.Target.UserId, hand = "BOTH", dist = grabDistBoth}
                    elseif grabbedDataL and grabbedDataL.Type == "PLAYER" then
                        grabPacket = {target = grabbedDataL.Target.UserId, hand = "L", dist = grabDistL}
                    elseif grabbedDataR and grabbedDataR.Type == "PLAYER" then
                        grabPacket = {target = grabbedDataR.Target.UserId, hand = "R", dist = grabDistR}
                    end

                    local objLData = grabbedDataL and {Name = grabbedDataL.Name, Type = grabbedDataL.Type, Dist = grabDistL} or nil
                    local objRData = grabbedDataR and {Name = grabbedDataR.Name, Type = grabbedDataR.Type, Dist = grabDistR} or nil

                    local packet = {
                        s = "VR50",
                        u = player.UserId,
                        un = player.Name,
                        st = HAND_STYLE,
                        lp = {relL.Position.X, relL.Position.Y, relL.Position.Z},
                        lr = {relL:ToEulerAnglesXYZ()},
                        rp = {relR.Position.X, relR.Position.Y, relR.Position.Z},
                        rr = {relR:ToEulerAnglesXYZ()},
                        wlp = {finalLeftCF.Position.X, finalLeftCF.Position.Y, finalLeftCF.Position.Z},
                        wlr = {finalLeftCF:ToEulerAnglesXYZ()},
                        wrp = {finalRightCF.Position.X, finalRightCF.Position.Y, finalRightCF.Position.Z},
                        wrr = {finalRightCF:ToEulerAnglesXYZ()},
                        hp = {camCF.Position.X, camCF.Position.Y, camCF.Position.Z},
                        hr = {camCF:ToEulerAnglesXYZ()},
                        gL = (grabbedDataL ~= nil or isClimbingL),
                        gR = (grabbedDataR ~= nil or isClimbingR),
                        cL = isClimbingL,
                        cR = isClimbingR,
                        aL = climbAnchorPosL and {climbAnchorPosL.X, climbAnchorPosL.Y, climbAnchorPosL.Z} or nil,
                        aR = climbAnchorPosR and {climbAnchorPosR.X, climbAnchorPosR.Y, climbAnchorPosR.Z} or nil,
                        objL = objLData,
                        objR = objRData,
                        gb = grabPacket
                    }
                    wsConnection:Send(HttpService:JSONEncode(packet))
                end)
            end

            -- // РЕНДЕРИНГ ДРУГИХ VR-ИГРОКОВ (60 FPS LERP)
            for uId, uData in pairs(remoteVRUsers) do
                if tick() - uData.LastTick > 7 then
                    if uData.Folder then uData.Folder:Destroy() end
                    remoteVRUsers[uId] = nil
                    updateNetCountLabel()
                else
                    uData.CurrentL = uData.CurrentL:Lerp(uData.TargetL, 0.35)
                    uData.CurrentR = uData.CurrentR:Lerp(uData.TargetR, 0.35)
                    uData.CurrentHead = uData.CurrentHead:Lerp(uData.TargetHead, 0.35)

                    if uData.Visor then
                        local vf, vg = uData.Visor:FindFirstChild("VisorFrame"), uData.Visor:FindFirstChild("VisorGlass")
                        local vCF = uData.CurrentHead * CFrame.new(0, 0.05, -0.3)
                        if vf then vf.CFrame = vCF end
                        if vg then vg.CFrame = vCF * CFrame.new(0, 0, -0.3) end
                    end

                    local function applyRemotePart(arm, isL, baseCF, isGrabbing, isClimbing, wallAnchor)
                        local finalBase = baseCF
                        if isClimbing and wallAnchor then
                            finalBase = CFrame.new(wallAnchor) * (baseCF - baseCF.Position)
                        end

                        local f, c, cr, p, ap, fg, sn, th, tt = arm:FindFirstChild("Forearm"), arm:FindFirstChild("Cuff"), arm:FindFirstChild("CuffRing"), arm:FindFirstChild("Palm"), arm:FindFirstChild("ArmorPlate"), arm:FindFirstChild("Fingers"), arm:FindFirstChild("Sensors"), arm:FindFirstChild("Thumb"), arm:FindFirstChild("ThumbTip")
                        local side = isL and -1 or 1
                        if f and c and p and fg then
                            f.CFrame = finalBase * CFrame.new(0, -0.02, 0.40)
                            c.CFrame = finalBase * CFrame.new(0, -0.01, -0.08)
                            if cr then cr.CFrame = finalBase * CFrame.new(0, -0.01, -0.16) end
                            p.CFrame = finalBase * CFrame.new(0, 0, -0.32)
                            if ap then ap.CFrame = finalBase * CFrame.new(0, 0.12, -0.32) end

                            if isGrabbing or isClimbing then
                                fg.CFrame = finalBase * CFrame.new(0, -0.06, -0.48) * CFrame.Angles(math.rad(-65), 0, 0)
                                if sn then sn.CFrame = finalBase * CFrame.new(0, 0.04, -0.50) end
                                if th then th.CFrame = finalBase * CFrame.new(side * 0.16, -0.06, -0.28) * CFrame.Angles(math.rad(-30), math.rad(side * 40), 0) end
                            else
                                fg.CFrame = finalBase * CFrame.new(0, -0.03, -0.62) * CFrame.Angles(math.rad(-10), 0, 0)
                                if sn then sn.CFrame = finalBase * CFrame.new(0, 0.08, -0.64) end
                                if th then th.CFrame = finalBase * CFrame.new(side * 0.22, -0.02, -0.30) * CFrame.Angles(0, math.rad(side * 28), math.rad(side * 10)) end
                            end
                            if tt and th then tt.CFrame = th.CFrame * CFrame.new(0, 0.08, -0.12) end
                        end
                    end

                    applyRemotePart(uData.Left, true, uData.CurrentL, uData.GrabL, uData.ClimbL, uData.AnchorL)
                    applyRemotePart(uData.Right, false, uData.CurrentR, uData.GrabR, uData.ClimbR, uData.AnchorR)

                    local function syncRemoteHeldItem(objData, handCF)
                        if not objData or not objData.Name then return end
                        local target = workspace:FindFirstChild(objData.Name) or (objData.Type == "PLAYER" and Players:FindFirstChild(objData.Name) and Players[objData.Name].Character)
                        if target and target ~= player.Character then
                            local d = objData.Dist or 4.0
                            local targetCF = handCF * CFrame.new(0, 0, -d)
                            if target:IsA("Model") then
                                target:PivotTo(target:GetPivot():Lerp(targetCF, 0.35))
                            elseif target:IsA("BasePart") then
                                target.CFrame = target.CFrame:Lerp(targetCF, 0.35)
                                target.AssemblyLinearVelocity = Vector3.zero
                            end
                        end
                    end

                    if uData.HeldObjL then syncRemoteHeldItem(uData.HeldObjL, uData.CurrentL) end
                    if uData.HeldObjR then syncRemoteHeldItem(uData.HeldObjR, uData.CurrentR) end
                end
            end
        end)
    end)
end

local function stopVR()
    pcall(function()
        VR_ACTIVE = false
        for _, w in pairs(widgetRegistry) do
            w.Frame.Visible = false
        end
        moveForward, moveBackward, moveLeft, moveRight = false, false, false, false
        grabbedDataL, grabbedDataR = nil, nil
        isClimbingL, isClimbingR = false, false
        climbAnchorPosL, climbAnchorPosR = nil, nil
        camTouchInput, camTouchLastPos = nil, nil
        screenTouchL, screenTouchR = nil, nil
        handDragL, handDragR = Vector3.zero, Vector3.zero

        if mainLoopConnection then mainLoopConnection:Disconnect() mainLoopConnection = nil end
        if physicsLoopConnection then physicsLoopConnection:Disconnect() physicsLoopConnection = nil end
        cleanupNet()

        netStatus.Text = "⚪ VR: Готов к запуску"
        netStatus.TextColor3 = Color3.fromRGB(180, 190, 205)

        camera.CameraType, camera.FieldOfView = Enum.CameraType.Custom, 70
        local curChar = player.Character
        if curChar then
            if curChar:FindFirstChildOfClass("Humanoid") then curChar:FindFirstChildOfClass("Humanoid").AutoRotate = true end
            for _, item in ipairs(curChar:GetDescendants()) do
                if item:IsA("BasePart") or item:IsA("Decal") then
                    item.LocalTransparencyModifier = 0
                end
            end
        end
        if viewmodelFolder then viewmodelFolder:Destroy() viewmodelFolder = nil end
        toggleBtn.Text, toggleBtn.TextColor3, cardStroke.Color = "⏻ ВКЛЮЧИТЬ VR", Color3.fromRGB(0, 255, 180), Color3.fromRGB(0, 255, 180)
    end)
end

