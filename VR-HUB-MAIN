local function registerEditableWidget(key, name, frame, baseSize, defaultTrans, updateFn)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness, stroke.Color, stroke.Enabled = 2, Color3.fromRGB(0, 255, 255), false
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    local wData = {
        Key = key, Name = name, Frame = frame, Stroke = stroke,
        BaseSize = baseSize, DefaultTrans = defaultTrans or 1, Scale = 1.0, UpdateFn = updateFn
    }
    widgetRegistry[key] = wData
    local dragging, dragStart, startPos = false, nil, nil
    frame.InputBegan:Connect(function(input)
        if EDITING_UI and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
            selectedWidgetKey = key
            for _, other in pairs(widgetRegistry) do other.Stroke.Color = Color3.fromRGB(0, 255, 255) end
            stroke.Color = Color3.fromRGB(255, 220, 0)
            inspectorLabel.Text = name .. "\nРазмер: " .. math.floor(wData.Scale * 100) .. "%"
            inspectorLabel.TextColor3 = Color3.fromRGB(255, 220, 0)
            dragging = true
            dragStart = Vector2.new(input.Position.X, input.Position.Y)
            startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and EDITING_UI and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end
